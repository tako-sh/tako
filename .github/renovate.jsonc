{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    // recommended defaults + action/docker digest pinning, config migration,
    // abandoned-package warnings, 3-day npm release age, weekly lockfile maintenance
    "config:best-practices",
    // one grouped PR for all minor/patch updates; majors stay separate
    "group:allNonMajor",
  ],
  "timezone": "Asia/Tokyo",
  // weekly batch; vulnerability alerts bypass the schedule
  "schedule": ["before 6am on monday"],
  // refresh supported locks weekly and merge once required checks pass
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
  },
  "labels": ["dependencies"],
  "postUpdateOptions": ["gomodTidy"],
  // vendor/pingora-core is the published pingora-core 0.9.0 source with local
  // patches (see vendor/README.md); its manifest must match that release
  "ignorePaths": ["**/node_modules/**", "e2e/fixtures/**", "vendor/**"],
  "packageRules": [
    // renovate-approve only approves PRs with automerge enabled;
    // keep major updates human-reviewed
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
    },
    // refresh in-range Cargo updates with the full dependency graph
    {
      "matchManagers": ["cargo"],
      "rangeStrategy": "replace",
    },
    // Pingora 0.9 creates zero-capacity buffers, which Tokio 1.54 rejects
    // on every connection; keep the =1.53.1 pin until upstream fixes it
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["tokio"],
      "allowedVersions": "<1.54.0",
    },
    // each notify-debouncer-mini release requires a specific notify major;
    // update them together
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["notify", "notify-debouncer-mini"],
      "groupName": "notify",
    },
    // keep existing ^ ranges; bun.lock already gives reproducibility,
    // so skip best-practices' devDependency pinning churn
    {
      "matchDepTypes": ["devDependencies"],
      "rangeStrategy": "auto",
    },
  ],
}
