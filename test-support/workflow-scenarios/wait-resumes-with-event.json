{
  "description": "A wait whose event payload is in the saved state returns that payload without parking again.",
  "drive": "run",
  "workflows": ["wait"],
  "steps": [
    {
      "expect": {
        "command": "claim_run",
        "app": "scenario-app",
        "worker_id": {
          "$var": "process_worker",
          "is": {
            "$type": "string"
          }
        },
        "names": ["wait"],
        "lease_ms": {
          "$var": "lease_ms",
          "is": {
            "$positive": true
          }
        }
      },
      "reply": {
        "status": "ok",
        "data": {
          "id": "run-1",
          "worker_id": "claim-1",
          "name": "wait",
          "payload": {},
          "status": "running",
          "attempts": 1,
          "max_attempts": 3,
          "run_at_ms": 1700000000000,
          "step_state": {
            "approval": {
              "approved": true
            }
          }
        }
      }
    },
    {
      "expect": {
        "command": "complete_run",
        "app": "scenario-app",
        "id": "run-1",
        "worker_id": "claim-1",
        "result": {
          "approved": true
        }
      },
      "reply": {
        "status": "ok",
        "data": {}
      }
    }
  ]
}
