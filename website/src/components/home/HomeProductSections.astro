---
import HomeDeployRun from "./HomeDeployRun.astro";
import HomeVpsMap from "./HomeVpsMap.astro";
import CopyButton from "../CopyButton.astro";
---

<section class="band" data-accent="mint" aria-labelledby="dev-title">
  <div class="band-inner split split-reverse">
    <div class="doc-text">
      <h2 class="section-title" id="dev-title">Develop against the whole platform</h2>
      <p>
        <code>tako dev</code> brings the production platform with it: workflows,
        channels, image optimization, secrets, and the same routing model your app uses
        after deploy.
      </p>
      <a class="action doc-link" href="/docs/development/">Development docs</a>
    </div>

    <figure class="routes-panel" data-reveal>
      <div class="panel-shade">
      <div class="routes-head">
        <span class="routes-app">demo</span>
        <span class="routes-status"><span class="status-dot" aria-hidden="true"></span>running</span>
      </div>
      <dl class="routes-list">
        <div class="route">
          <dt>routes</dt>
          <dd><code>https://demo.test</code><span>your app, on real HTTPS</span></dd>
        </div>
        <div class="route">
          <dt><span class="visually-hidden">routes</span></dt>
          <dd><code>https://*.demo.test</code><span>wildcard subdomains</span></dd>
        </div>
        <div class="route">
          <dt>lan</dt>
          <dd><code>https://demo.local</code><span>phones and other devices on your network</span></dd>
        </div>
        <div class="route">
          <dt>tunnel</dt>
          <dd><code>public URL</code><span>share your local app beyond the network</span></dd>
        </div>
      </dl>
      </div>
      <figcaption class="figure-note">The routes <code>tako dev</code> prints for the demo app.</figcaption>
    </figure>
  </div>
</section>

<section class="band band-raised" data-accent="coral" aria-labelledby="deploy-title">
  <div class="band-inner">
    <div class="deploy-head">
      <h2 class="section-title section-title-lg" id="deploy-title">Fast rolling deploys to your VPS</h2>
      <div class="doc-text">
        <p>PaaS-style release safety on servers you own.</p>
        <p>
          <code>tako deploy</code> gives you health-gated traffic switches,
          zero-downtime rollouts, and rollback without moving off your VPS.
        </p>
        <a class="action doc-link" href="/docs/deployment/">Deployment docs</a>
      </div>
    </div>

    <HomeDeployRun />
  </div>
</section>

<section class="band" data-accent="gold" aria-labelledby="platform-title">
  <div class="band-inner">
    <div class="split">
      <div class="doc-text">
        <h2 class="section-title" id="platform-title">Your VPS becomes the platform</h2>
        <p>
          Your VPS stays yours. <code>tako-server</code> adds the platform layer:
          TLS, routing, processes, logs, secrets, rollbacks, and scale-to-zero
          workers without hiding SSH or the machine.
        </p>
        <p>
          The same server runs your app primitives: secrets, env vars, workflows,
          channels, image optimization, storage, cache, and backups. They work
          together and stay available from code, so you or your coding agent can
          build features without assembling extra services.
        </p>
        <a class="action doc-link" href="/docs/how-tako-works/">How Tako works</a>
      </div>

      <HomeVpsMap />
    </div>

    <div class="panel-shade primitive-frame">
    <div class="panel primitive-workbench" aria-label="Tako primitive code examples" data-primitive-workbench>
      <div class="primitive-tabs" role="tablist" aria-label="Primitive code examples">
        <button
          class="primitive-tab is-active"
          type="button"
          role="tab"
          id="primitive-tab-secrets"
          aria-selected="true"
          aria-controls="primitive-panel-secrets"
          data-primitive-tab="secrets"
        >
          database.ts
        </button>
        <button
          class="primitive-tab"
          type="button"
          role="tab"
          id="primitive-tab-env"
          aria-selected="false"
          aria-controls="primitive-panel-env"
          data-primitive-tab="env"
          tabindex="-1"
        >
          runtime.ts
        </button>
        <button
          class="primitive-tab"
          type="button"
          role="tab"
          id="primitive-tab-workflows"
          aria-selected="false"
          aria-controls="primitive-panel-workflows"
          data-primitive-tab="workflows"
          tabindex="-1"
        >
          ship-order.ts
        </button>
        <button
          class="primitive-tab"
          type="button"
          role="tab"
          id="primitive-tab-channels"
          aria-selected="false"
          aria-controls="primitive-panel-channels"
          data-primitive-tab="channels"
          tabindex="-1"
        >
          deploys.ts
        </button>
        <button
          class="primitive-tab"
          type="button"
          role="tab"
          id="primitive-tab-images"
          aria-selected="false"
          aria-controls="primitive-panel-images"
          data-primitive-tab="images"
          tabindex="-1"
        >
          hero-image.tsx
        </button>
      </div>

      <div class="primitive-panels">
        <CopyButton class="primitive-copy" ariaLabel="Copy code" title="Copy code" />
        <section
          class="primitive-panel"
          id="primitive-panel-channels"
          role="tabpanel"
          aria-labelledby="primitive-tab-channels"
          data-primitive-panel="channels"
          hidden
        >
          <div class="primitive-editor">
            <pre><code><span class="syntax-comment">// src/channels/deploys.ts</span>
<span class="syntax-comment">// durable app events, no realtime vendor</span>
<span class="syntax-keyword">import</span> &#123; defineChannel &#125; <span class="syntax-keyword">from</span> <span class="syntax-string">"tako.sh"</span>;

<span class="syntax-comment">// typed messages are stored for replay, then fanned out</span>
<span class="syntax-comment">// to every connected SSE/WebSocket client</span>
<span class="syntax-keyword">type</span> DeployMessages = &#123;
  status: &#123;
    release: <span class="syntax-type">string</span>;
    state: <span class="syntax-string">"building"</span> | <span class="syntax-string">"healthy"</span>;
  &#125;;
&#125;;

<span class="syntax-keyword">export default</span> defineChannel(<span class="syntax-string">"deploys"</span>)
  .$messageTypes&lt;DeployMessages&gt;();

<span class="syntax-comment">// src/routes/deploy.ts</span>
<span class="syntax-comment">// server-side publish</span>
<span class="syntax-keyword">import</span> deploys <span class="syntax-keyword">from</span> <span class="syntax-string">"../channels/deploys"</span>;

<span class="syntax-comment">// late clients can reconnect and catch up from replay</span>
<span class="syntax-keyword">await</span> deploys.publish(&#123;
  type: <span class="syntax-string">"status"</span>,
  data: &#123;
    release: id,
    state: <span class="syntax-string">"healthy"</span>,
  &#125;,
&#125;);</code></pre>
          </div>
        </section>

        <section
          class="primitive-panel"
          id="primitive-panel-workflows"
          role="tabpanel"
          aria-labelledby="primitive-tab-workflows"
          data-primitive-panel="workflows"
          hidden
        >
          <div class="primitive-editor">
            <pre><code><span class="syntax-comment">// src/workflows/ship-order.ts</span>
<span class="syntax-comment">// checkpoint steps, park for approval, then resume</span>
<span class="syntax-keyword">import</span> &#123; defineWorkflow &#125; <span class="syntax-keyword">from</span> <span class="syntax-string">"tako.sh"</span>;

<span class="syntax-keyword">export default</span> defineWorkflow&lt;&#123; orderId: <span class="syntax-type">string</span> &#125;&gt;(<span class="syntax-string">"ship-order"</span>, &#123;
  handler: <span class="syntax-keyword">async</span> (&#123; orderId &#125;, ctx) =&gt; &#123;
    <span class="syntax-keyword">const</span> event = <span class="syntax-string">"approval:"</span> + orderId;
    <span class="syntax-keyword">await</span> ctx.run(<span class="syntax-string">"charge"</span>, () =&gt; billing.charge(orderId));

    <span class="syntax-comment">// parks the run until a route or webhook sends signal()</span>
    <span class="syntax-keyword">const</span> approval = <span class="syntax-keyword">await</span> ctx.waitFor&lt;&#123; approved: <span class="syntax-type">boolean</span> &#125;&gt;(
      event,
    );
    <span class="syntax-keyword">if</span> (!approval?.approved) ctx.bail(<span class="syntax-string">"not approved"</span>);

    <span class="syntax-keyword">await</span> ctx.run(<span class="syntax-string">"ship"</span>, () =&gt; fulfillment.ship(orderId));
  &#125;,
&#125;);

<span class="syntax-comment">// src/routes/approve.ts</span>
<span class="syntax-keyword">import</span> &#123; signal &#125; <span class="syntax-keyword">from</span> <span class="syntax-string">"tako.sh"</span>;

<span class="syntax-comment">// wakes the waitFor() above</span>
<span class="syntax-keyword">await</span> signal(<span class="syntax-string">"approval:"</span> + orderId, &#123;
  approved: <span class="syntax-keyword">true</span>,
&#125;);</code></pre>
          </div>
        </section>

        <section
          class="primitive-panel"
          id="primitive-panel-images"
          role="tabpanel"
          aria-labelledby="primitive-tab-images"
          data-primitive-panel="images"
          hidden
        >
          <div class="primitive-editor">
            <pre><code><span class="syntax-comment">// src/components/hero-image.tsx</span>
<span class="syntax-comment">// optimized image URLs from app code</span>
<span class="syntax-keyword">import</span> &#123; imageUrl &#125; <span class="syntax-keyword">from</span> <span class="syntax-string">"tako.sh"</span>;

<span class="syntax-keyword">export function</span> HeroImage() &#123;
  <span class="syntax-comment">// returns a normal URL backed by /_tako/image</span>
  <span class="syntax-keyword">const</span> src = imageUrl(<span class="syntax-string">"/images/hero.png"</span>, &#123;
    width: <span class="syntax-number">1200</span>,
    format: <span class="syntax-string">"webp"</span>,
  &#125;);

  <span class="syntax-keyword">return</span> (
    &lt;img
      src=&#123;src&#125;
      alt=<span class="syntax-string">"Product dashboard"</span>
      width=&#123;<span class="syntax-number">1200</span>&#125;
      height=&#123;<span class="syntax-number">720</span>&#125;
    /&gt;
  );
&#125;</code></pre>
          </div>
        </section>

        <section
          class="primitive-panel"
          id="primitive-panel-env"
          role="tabpanel"
          aria-labelledby="primitive-tab-env"
          data-primitive-panel="env"
          hidden
        >
          <div class="primitive-editor">
            <pre><code><span class="syntax-comment">// src/config/runtime.ts</span>
<span class="syntax-comment">// runtime metadata and typed public vars</span>
<span class="syntax-keyword">import</span> &#123; tako &#125; <span class="syntax-keyword">from</span> <span class="syntax-string">"tako.sh"</span>;

<span class="syntax-comment">// generated types know your environments and public vars</span>
<span class="syntax-keyword">export const</span> runtime = &#123;
  env: tako.env,
  isProduction: tako.isProd,
  build: tako.build,
&#125;;

<span class="syntax-keyword">export const</span> publicConfig = &#123;
  origin: process.env.PUBLIC_ORIGIN,
&#125;;</code></pre>
          </div>
        </section>

        <section
          class="primitive-panel is-active"
          id="primitive-panel-secrets"
          role="tabpanel"
          aria-labelledby="primitive-tab-secrets"
          data-primitive-panel="secrets"
        >
          <div class="primitive-editor">
            <pre><code><span class="syntax-comment">// src/server/database.ts</span>
<span class="syntax-comment">// typed secret reads, no env files</span>
<span class="syntax-keyword">import</span> &#123; tako &#125; <span class="syntax-keyword">from</span> <span class="syntax-string">"tako.sh"</span>;

<span class="syntax-keyword">export function</span> connectDatabase() &#123;
  <span class="syntax-keyword">return</span> createClient(&#123;
    <span class="syntax-comment">// read the one value you need; never log the bag</span>
    url: tako.secrets.DATABASE_URL,
    ssl: tako.isProd,
  &#125;);
&#125;</code></pre>
          </div>
        </section>
      </div>
    </div>
    </div>
  </div>
</section>

<script>
  const workbenches = document.querySelectorAll<HTMLElement>("[data-primitive-workbench]");

  for (const workbench of workbenches) {
    // Line numbers in a muted gutter, so each sample reads like a file in an editor.
    for (const pre of workbench.querySelectorAll<HTMLElement>(".primitive-editor pre")) {
      const lines = (pre.textContent ?? "").split("\n").length;
      const gutter = document.createElement("span");
      gutter.className = "line-gutter";
      gutter.setAttribute("aria-hidden", "true");
      gutter.textContent = Array.from({ length: lines }, (_, index) => String(index + 1)).join("\n");
      pre.prepend(gutter);
    }

    const tabs = [...workbench.querySelectorAll<HTMLButtonElement>("[data-primitive-tab]")];
    const panels = [...workbench.querySelectorAll<HTMLElement>("[data-primitive-panel]")];

    const activate = (name: string | null) => {
      for (const tab of tabs) {
        const selected = tab.getAttribute("data-primitive-tab") === name;
        tab.classList.toggle("is-active", selected);
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
      }

      for (const panel of panels) {
        const selected = panel.getAttribute("data-primitive-panel") === name;
        panel.classList.toggle("is-active", selected);
        panel.hidden = !selected;
      }
    };

    // Copy copies the open file's code, without the line numbers.
    const copy = workbench.querySelector<HTMLButtonElement>(".primitive-copy");
    const copyLabel = copy?.querySelector("[data-copy-label]");
    copy?.addEventListener("click", async () => {
      const code = panels.find((panel) => !panel.hidden)?.querySelector("code");
      let copied = true;
      try {
        await navigator.clipboard.writeText(code?.textContent?.trim() ?? "");
      } catch {
        copied = false;
      }
      copy.classList.toggle("is-copied", copied);
      if (copyLabel) copyLabel.textContent = copied ? "Copied" : "Failed";
      setTimeout(() => {
        copy.classList.remove("is-copied");
        if (copyLabel) copyLabel.textContent = "Copy";
      }, 1400);
    });

    workbench.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;
      const tab = event.target.closest("[data-primitive-tab]");
      if (!tab || !workbench.contains(tab)) return;
      activate(tab.getAttribute("data-primitive-tab"));
    });

    workbench.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;

      const currentIndex = tabs.findIndex((tab) => tab === document.activeElement);
      if (currentIndex === -1) return;

      event.preventDefault();
      const offset = event.key === "ArrowRight" ? 1 : -1;
      const next = tabs[(currentIndex + offset + tabs.length) % tabs.length];
      if (!next) return;
      next.focus();
      activate(next.getAttribute("data-primitive-tab"));
    });
  }
</script>
