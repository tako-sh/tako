---
import HomeCheck from "./HomeCheck.astro";
---

<section class="band band-raised" data-accent="coral" aria-labelledby="box-title">
  <div class="band-inner">
    <h2 class="section-title" id="box-title">Fast defaults, no giant matrix of knobs</h2>
    <ul class="spec-list">
      <li class="spec">
        <HomeCheck />
        <div>
          <h3 class="spec-name">Zero-downtime server updates</h3>
          <p class="spec-detail">One command upgrades the server. Tako handles the handoff.</p>
        </div>
      </li>
      <li class="spec">
        <HomeCheck />
        <div>
          <h3 class="spec-name">Built-in load balancer</h3>
          <p class="spec-detail">Scales down to <code>0</code>, with server-side limits that stop runaway process counts.</p>
        </div>
      </li>
      <li class="spec">
        <HomeCheck />
        <div>
          <h3 class="spec-name">Portless local HTTPS</h3>
          <p class="spec-detail">
            Was it 3000? 5000? Or 8081? None of them. Local apps run on <code>https://*.test</code> (<a href="https://www.rfc-editor.org/rfc/rfc6761#section-6.2" target="_blank" rel="noopener noreferrer">RFC 6761</a>).
          </p>
        </div>
      </li>
      <li class="spec">
        <HomeCheck />
        <div>
          <h3 class="spec-name">HTTPS by default</h3>
          <p class="spec-detail">Production routes get TLS, and plain HTTP redirects to HTTPS.</p>
        </div>
      </li>
      <li class="spec">
        <HomeCheck />
        <div>
          <h3 class="spec-name">Subdomains and path routes</h3>
          <p class="spec-detail">Subdomains? Custom path routes? Done.</p>
        </div>
      </li>
      <li class="spec">
        <HomeCheck />
        <div>
          <h3 class="spec-name">Static files</h3>
          <p class="spec-detail">Served straight from your app&rsquo;s <code>public</code> folder.</p>
        </div>
      </li>
      <li class="spec">
        <HomeCheck />
        <div>
          <h3 class="spec-name">Secrets and variables</h3>
          <p class="spec-detail">Per environment. Scoped and ready.</p>
        </div>
      </li>
      <li class="spec">
        <HomeCheck />
        <div>
          <h3 class="spec-name">Images and storage URLs</h3>
          <p class="spec-detail">Resize public images on the fly and hand out signed storage URLs.</p>
        </div>
      </li>
      <li class="spec">
        <HomeCheck />
        <div>
          <h3 class="spec-name">Status and logs</h3>
          <p class="spec-detail">Check status and read logs from the CLI.</p>
        </div>
      </li>
    </ul>
  </div>
</section>
