<script>
  // The poster frame stays in place unless the player and the recording both load.
  import { create } from "asciinema-player";
  import "asciinema-player/dist/bundle/asciinema-player.css";

  const playerSlot = document.querySelector<HTMLElement>("[data-tako-dev-player]");
  if (playerSlot) {
    fetch("/assets/tako-dev.cast")
      .then((response) => (response.ok ? response.text() : Promise.reject(new Error(String(response.status)))))
      .then((data) => {
        const mount = document.createElement("div");
        mount.className = "dev-player-mount";
        // The player reads the theme's palette from computed styles, so the mount must be in the page first.
        playerSlot.replaceChildren(mount);
        // 22 rows holds the wordmark and the whole dashboard; the 8s poster shows the logs and routes.
        create({ data }, mount, { theme: "tako", fit: "width", rows: 22, poster: "npt:0:8", idleTimeLimit: 2 });
      })
      .catch(() => {
        // Keep the poster frame and its link.
      });
  }
</script>
