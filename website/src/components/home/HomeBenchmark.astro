<section class="band" data-accent="mint" aria-labelledby="performance-title">
  <div class="band-inner">
    <h2 class="section-title section-title-lg" id="performance-title">Ready for serious load</h2>

    <figure class="bench">
      <div
        class="bench-chart"
        data-reveal
        role="img"
        aria-label="Clean HTTPS 200 responses per second on one small VM, higher is better: Tako 12.5k, Caddy 5.2k, Envoy 4.7k."
      >
        <div class="bench-row bench-row-tako">
          <span class="bench-name">Tako</span>
          <span class="bench-track"><span class="bench-fill" style="--f: 1"></span><span class="bench-value">12.5k</span></span>
        </div>
        <div class="bench-row">
          <span class="bench-name">Caddy</span>
          <span class="bench-track"><span class="bench-fill" style="--f: 0.416"></span><span class="bench-value">5.2k</span></span>
        </div>
        <div class="bench-row">
          <span class="bench-name">Envoy</span>
          <span class="bench-track"><span class="bench-fill" style="--f: 0.376"></span><span class="bench-value">4.7k</span></span>
