---
import { benchmark, format, short } from "../../data/performance";
const rows = benchmark.http.filter((row) => row.proxy === "tako");
const concurrency = Math.max(...rows.map((row) => row.conc));
const failures = rows.reduce(
  (total, row) => total + row.non200 + row.clientErrors,
  0,
);
const runs = rows.reduce((total, row) => total + row.rawCases.length, 0);
const clean = rows.every((row) => row.clean);
---

<section class="band" data-accent="mint" aria-labelledby="performance-title">
  <div class="band-inner">
    <h2 class="section-title section-title-lg" id="performance-title">
      Small server. Serious load.
    </h2>
    <dl class="bench-facts">
      <div>
        <dt>concurrent clients tested</dt>
        <dd>{short(concurrency)}</dd>
      </div>
      <div>
        <dt>failed requests</dt>
        <dd>{format(failures)}</dd>
      </div>
      <div>
        <dt>CPUs shared by the whole test</dt>
        <dd>2</dd>
      </div>
    </dl>
    <div class="bench-copy">
      <p>
        {
          clean ? (
            <>
              Tako completed <strong>every request successfully</strong> across{" "}
              {format(runs)} HTTPS test runs, up to {format(concurrency)}{" "}
              concurrent clients. Zero HTTP errors. Zero client errors.
            </>
          ) : (
            <>
              We tested Tako across {format(runs)} HTTPS runs, up to{" "}
              {format(concurrency)} concurrent clients. The full report includes
              every successful response, HTTP error, and client error.
            </>
          )
        }
      </p>
      <p>
        Proxy, app, and load generator shared two CPUs and an 8 GiB memory
        limit. See throughput, latency, memory, and the full five-proxy
        comparison in the report.
      </p>
      <p class="bench-date">
        Measured {benchmark.date}. {benchmark.repetitions} runs at every tested concurrency.
      </p>
      <a class="action doc-link" href="/performance/"
        >See the results and methodology</a
      >
    </div>
  </div>
</section>
