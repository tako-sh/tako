<style is:inline>
			html {
				scroll-behavior: smooth;
			}
			:root {
				/* Dark ground in the brand ink; --ink is the text colour. */
				--bg: #1f1b2b;
				--paper: #2f2a44;
				--panel: #2f2a44;
				--panel-strong: #2f2a44;
				--zebra: rgba(239, 235, 230, 0.035);
				--ink: #efebe6;
				--on-primary: #1f1b2b;
				--primary: #e88783;
				--primary-text: #e88783;
				--secondary: #9bc4b6;
				--gold: #d6a63e;
				--line: rgba(239, 235, 230, 0.14);
				--line-strong: rgba(239, 235, 230, 0.32);
				--muted: #b8b2c2;
				--accent: var(--primary-text);
				--code-bg: #2f2a44;
				--code-text: #efebe6;
				--code-line: rgba(239, 235, 230, 0.12);
				--site-width: min(1100px, calc(100vw - 32px));
				/* Side gutter for full-width bands: the header, the footer and full-bleed pages. */
				--gutter: clamp(20px, 5vw, 80px);
				--panel-radius: 3px;
				--radius: 3px;
				--font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
				--font-sans: var(--font-mono);
				--font-heading: var(--font-mono);
				color-scheme: dark;
				accent-color: var(--primary);
				scrollbar-color: rgba(239, 235, 230, 0.28) transparent;
			}


			::selection {
				background: var(--primary);
				color: var(--on-primary);
			}

			body {
				caret-color: var(--primary);
				font-size: 15px;
				line-height: 1.65;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			/*
			 * Marks: the site marks things up like an annotated document. A link sits on a low,
			 * translucent stroke in its band's accent (coral outside the home bands) that rises to a
			 * full highlight on hover. The primary button is the fully marked state, and text
			 * selection uses the same coral. Copy buttons mark in neutral ink.
			 */
			a:not([class]),
			.nav-links a,
			.mobile-menu a,
			.footer-col a,
			.mark,
			.action,
			.copy-button {
				--mark-color: color-mix(in srgb, var(--band-accent, var(--primary)) 45%, transparent);
				background-image: linear-gradient(var(--mark-color), var(--mark-color));
				background-position: left bottom;
				background-repeat: no-repeat;
				background-size: 100% var(--mark-rest, 0.3em);
				box-decoration-break: clone;
				-webkit-box-decoration-break: clone;
				transition: background-size 0.18s cubic-bezier(0.22, 1, 0.36, 1);
			}

			a:not([class]):hover,
			.nav-links a:hover,
			.mobile-menu a:hover,
			.footer-col a:hover,
			.mark:hover,
			.action:hover,
			.copy-button:hover {
				background-size: 100% 100%;
			}

			/* Links stand out from muted text, and stay legible on their full hover highlight. */
			a:not([class]) {
				color: var(--ink);
			}

			/* Padded controls keep the mark on their text, not on the whole hit area. */
			.nav-links a,
			.mobile-menu a,
			.action,
			.copy-button {
				background-origin: content-box;
				background-clip: content-box;
			}

			:focus-visible {
				outline: 2px solid var(--primary);
				outline-offset: 3px;
			}

			/* The one solid action: coral, ink label, a small press */
			.button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 8px;
				height: 44px;
				padding: 0 20px;
				border: 0;
				border-radius: var(--radius);
				background: var(--primary);
				color: var(--on-primary);
				cursor: pointer;
				font: 700 14px/1 var(--font-mono);
				transition:
					background-color 0.15s,
					translate 0.1s;
			}

			.button:hover {
				background: color-mix(in srgb, var(--primary) 82%, var(--ink));
			}

			.button:active {
				translate: 0 1px;
			}

			.button-icon {
				width: 0.9em;
				height: 0.9em;
				stroke-width: 2;
			}

			/* Secondary actions are marked text with a 44px hit area */
			.action {
				display: inline-flex;
				align-items: center;
				gap: 6px;
				padding: 15px 2px;
				color: var(--ink);
				font: 600 14px/1 var(--font-mono);
			}

			/* Quiet controls: small labels on a neutral mark */
			.copy-button {
				--mark-color: color-mix(in srgb, var(--ink) 22%, transparent);
				display: inline-flex;
				flex: 0 0 auto;
				align-items: center;
				justify-content: center;
				padding: 11px 8px;
				border: 0;
				background-color: transparent;
				color: var(--ink);
				cursor: pointer;
				font: 500 13px/1 var(--font-mono);
			}

			.copy-button.is-copied {
				color: var(--secondary);
			}

			@media (prefers-reduced-motion: reduce) {
				a,
				.mark,
				.action,
					.copy-button,
				.button {
					transition: none;
				}
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			html,
			body {
				min-height: 100%;
			}

			html {
				font-family: var(--font-sans);
				overflow-x: hidden;
			}

			h1,
			h2,
			h3,
			h4,
			h5,
			h6 {
				font-family: var(--font-heading);
			}

			body {
				color: var(--ink);
				background: var(--bg);
				overflow-x: hidden;
			}

			.site {
				position: relative;
				display: flex;
				flex-direction: column;
				min-height: 100vh;
			}

			.content-stack {
				display: flex;
				flex-direction: column;
				gap: 24px;
				margin: 10px 0 0;
				flex: 1;
			}

			.container {
				width: var(--site-width);
				margin: 0 auto;
			}

			.frame {
				width: calc(100% - 2 * var(--gutter));
				margin: 0 auto;
			}

			.full-bleed {
				width: 100%;
			}

			.header {
				position: sticky;
				top: 0;
				z-index: 100;
				background: var(--bg);
				box-shadow: 0 1px 0 transparent;
			}

			.header.is-scrolled {
				box-shadow: 0 1px 0 var(--line);
			}

			.header > .frame {
				position: relative;
			}

			.header-inner {
				padding: 16px 0;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 16px;
			}

			.header-sentinel {
				position: absolute;
				top: 0;
				left: 0;
				width: 1px;
				height: 1px;
				pointer-events: none;
			}

			.logo {
				display: inline-flex;
				align-items: center;
				gap: 10px;
				color: var(--ink);
				text-decoration: none;
				font-family: var(--font-sans);
				font-size: 16px;
				font-weight: 700;
				line-height: 1;
			}

			#logo-text {
				display: inline-block;
			}

			.logo img {
				width: 26px;
				height: 26px;
			}

			.nav-links {
				display: flex;
				gap: 8px;
				align-items: center;
				flex-wrap: wrap;
				justify-content: flex-end;
			}

			.nav-links a {
				text-decoration: none;
				color: var(--ink);
				padding: 7px 8px;
				font-family: var(--font-sans);
				font-size: 14px;
				font-weight: 500;
				line-height: 1;
			}

			/* Nav and footer links carry no mark until hover */
			.nav-links a,
			.mobile-menu a,
			.footer-col a {
				--mark-rest: 0;
			}


			.x-link {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 12px 10px;
			}

			.discord-link {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 9px 8px;
			}

			.discord-link svg {
				width: 18px;
				height: 18px;
			}

			.github-star {
				display: inline-flex;
				align-items: center;
				gap: 6px;
			}

			.github-star .star-icon {
				width: 0.95em;
				height: 0.95em;
			}

			.github-star .star-icon path {
				fill: var(--gold);
				stroke: var(--gold);
				stroke-width: 1.5;
				stroke-linecap: round;
				stroke-linejoin: round;
			}

			.demo-link {
				display: inline-flex;
				align-items: center;
				gap: 4px;
			}

			.demo-link .demo-icon {
				width: 0.82em;
				height: 0.82em;
				stroke-width: 2.4;
			}

			.mobile-menu-icon {
				width: 16px;
				height: 16px;
				vertical-align: -2px;
				margin-right: 6px;
			}

			main {
				margin: 0 auto;
			}

			.site-footer {
				overflow: hidden;
				margin-top: auto;
				padding-top: 32px;
			}

			.site-footer > .frame {
				position: relative;
			}

			.footer-columns {
				position: relative;
				z-index: 1;
				display: grid;
				grid-template-columns: repeat(4, auto);
				justify-content: space-between;
				gap: 28px 24px;
				padding: 28px 0 20px;
			}

			.footer-col {
				display: flex;
				flex-direction: column;
				gap: 8px;
			}

			.footer-col-title {
				font-family: var(--font-sans);
				font-size: 14px;
				font-weight: 700;
				color: var(--ink);
				margin-bottom: 4px;
			}

			.footer-col a {
				color: var(--muted);
				font-family: var(--font-sans);
				font-size: 14px;
				font-weight: 400;
			}

			.footer-col a:hover {
				color: var(--ink);
			}

			.footer-note {
				position: relative;
				z-index: 1;
				display: grid;
				grid-template-columns:
					minmax(0, 1fr) minmax(520px, 720px)
					minmax(0, 1fr);
				align-items: start;
				min-height: clamp(320px, 28vw, 380px);
				gap: 20px;
				overflow: hidden;
				color: var(--muted);
				padding: 18px 0 0;
				border-top: 1px solid var(--line);
				margin: 0;
				text-align: center;
				font-family: var(--font-sans);
				line-height: 1.35;
			}

			.footer-note-main,
			.footer-note-mark {
				position: relative;
				z-index: 2;
				display: inline-block;
				font-size: 13px;
				font-weight: 400;
				color: var(--muted);
			}

			.footer-note-main {
				grid-column: 1;
				justify-self: start;
			}

			.footer-note-mark {
				grid-column: 3;
				justify-self: end;
			}

			.footer-story {
				position: absolute;
				left: 50%;
				bottom: 0;
				z-index: 1;
				width: clamp(420px, 42vw, 560px);
				aspect-ratio: 1200 / 659;
				display: block;
				pointer-events: none;
				opacity: var(--footer-story-opacity, 1);
				transform: translate(-50%, var(--footer-story-y, 0px))
					scale(var(--footer-story-scale, 1));
				transform-origin: 50% 100%;
			}

			.site-footer.is-footer-story-ready .footer-story {
				--footer-story-y: 140px;
				--footer-story-scale: 0.95;
				--footer-story-opacity: 0.14;
				transition:
					transform 1100ms cubic-bezier(0.16, 1, 0.3, 1),
					opacity 620ms ease-out;
			}

			.site-footer.is-footer-story-visible .footer-story {
				--footer-story-y: 0px;
				--footer-story-scale: 1;
				--footer-story-opacity: 1;
			}

			.footer-story-layer {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				display: block;
				object-fit: contain;
				object-position: 50% 100%;
				opacity: var(--footer-layer-opacity, 1);
				transform: translateY(var(--footer-layer-y, 0px));
				transform-origin: 50% 100%;
			}

			.site-footer.is-footer-story-ready .footer-story-layer {
				--footer-layer-y: 70px;
				transition: transform 1100ms cubic-bezier(0.16, 1, 0.3, 1);
			}

			.site-footer.is-footer-story-visible .footer-story-layer {
				--footer-layer-y: 0px;
			}

			@media (prefers-reduced-motion: reduce) {
				.footer-story {
					opacity: 1;
					transform: translate(-50%, 0) scale(1);
					transition: none;
				}

				.footer-story-layer {
					opacity: 1;
					animation: none;
					transform: translateY(0);
					transition: none;
				}
			}

			@media (max-width: 720px) {
				.footer-columns {
					grid-template-columns: repeat(2, auto);
					gap: 24px 16px;
				}

				.footer-note {
					grid-template-columns: 1fr 1fr;
					align-items: start;
					min-height: 306px;
					gap: 16px;
					padding-top: 22px;
				}

				.footer-note-main {
					grid-column: 1;
					justify-self: start;
					text-align: left;
				}

				.footer-note-mark {
					grid-column: 2;
					justify-self: end;
					text-align: right;
				}

				.footer-story {
					width: min(460px, calc(100vw + 60px));
				}
			}

			.mobile-nav-controls {
				display: none;
				align-items: center;
				gap: 8px;
			}

			.hamburger {
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				gap: 4px;
				width: 44px;
				height: 44px;
				padding: 8px;
				border: 1px solid transparent;
				border-radius: var(--radius);
				background: transparent;
				cursor: pointer;
				-webkit-tap-highlight-color: transparent;
			}

			.hamburger:hover {
				border-color: var(--line);
			}

			.hamburger-line {
				display: block;
				width: 16px;
				height: 2px;
				background: var(--ink);
				border-radius: 1px;
				transform-origin: center;
			}

			.hamburger.is-open .hamburger-line:nth-child(1) {
				transform: translateY(6px) rotate(135deg);
			}

			.hamburger.is-open .hamburger-line:nth-child(2) {
				transform: scaleX(0);
				opacity: 0;
			}

			.hamburger.is-open .hamburger-line:nth-child(3) {
				transform: translateY(-6px) rotate(-135deg);
			}

			.mobile-menu {
				position: absolute;
				top: calc(100% + 8px);
				left: 0;
				right: 0;
				display: flex;
				flex-direction: column;
				gap: 2px;
				padding: 8px;
				border: 1px solid var(--line);
				border-radius: var(--radius);
				background: var(--bg);
				overflow: hidden;
				visibility: hidden;
			}

			.mobile-menu.is-open {
				visibility: visible;
			}

			.mobile-menu a {
				text-decoration: none;
				color: var(--ink);
				font-family: var(--font-sans);
				font-size: 15px;
				font-weight: 500;
				padding: 10px 14px;
			}


			@media (max-width: 640px) {
				.header-inner {
					padding: 10px 0;
				}

				.desktop-nav {
					display: none;
				}

				.mobile-nav-controls {
					display: flex;
				}
			}
		</style>
