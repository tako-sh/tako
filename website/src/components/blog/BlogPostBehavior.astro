---
import HugeIcon from "../HugeIcon.astro";
import PlusIcon from "@hugeicons/core-free-icons/Add01Icon";
import MinusIcon from "@hugeicons/core-free-icons/Remove01Icon";
import XMarkIcon from "@hugeicons/core-free-icons/Cancel01Icon";
---
<template id="diagram-zoom-in-icon"><HugeIcon icon={PlusIcon} aria-hidden="true" focusable="false" /></template>
<template id="diagram-zoom-out-icon"><HugeIcon icon={MinusIcon} aria-hidden="true" focusable="false" /></template>
<template id="diagram-close-icon"><HugeIcon icon={XMarkIcon} aria-hidden="true" focusable="false" /></template>

<script>
  (function() {
    const article = document.querySelector(".blog-article");
    if (!article) return;
    for (const heading of article.querySelectorAll<HTMLElement>("h2[id], h3[id], h4[id], h5[id], h6[id]")) {
      const id = heading.id;
      if (!id || heading.querySelector(".heading-anchor")) continue;
      const anchor = document.createElement("a");
      anchor.className = "heading-anchor";
      anchor.href = "#" + id;
      anchor.textContent = "#";
      anchor.setAttribute("aria-hidden", "true");
      heading.append(anchor);
      heading.style.cursor = "pointer";
      heading.addEventListener("click", (event) => {
        if (!(event.target instanceof Element) || event.target.closest("a") || window.getSelection()?.toString()) return;
        window.location.hash = id;
      });
    }
    for (const table of article.querySelectorAll("table")) {
      const wrap = document.createElement("div");
      wrap.className = "table-scroll";
      table.before(wrap);
      wrap.append(table);
    }

    for (const diagram of article.querySelectorAll<HTMLImageElement>('img[src^="/d2/"]')) {
      enhanceDiagram(diagram);
    }

    function enhanceDiagram(img: HTMLImageElement) {
      if (!img.parentNode || img.closest(".diagram-shell")) return;

      const shell = document.createElement("figure");
      shell.className = "diagram-shell";

      const viewport = document.createElement("div");
      viewport.className = "diagram-viewport";

      const canvas = document.createElement("div");
      canvas.className = "diagram-canvas";

      img.parentNode.insertBefore(shell, img);
      shell.appendChild(viewport);
      viewport.appendChild(canvas);
      canvas.appendChild(img);

      img.classList.add("diagram-image");
      img.draggable = false;

      img.addEventListener("click", function() {
        openLightbox(img);
      });
    }

    function openLightbox(sourceImg: HTMLImageElement) {
      const existing = document.querySelector<HTMLDialogElement>(".diagram-lightbox");
      if (existing) existing.close();

      const shell = document.createElement("dialog");
      shell.className = "diagram-lightbox";
      shell.setAttribute("aria-label", sourceImg.alt || "Diagram viewer");
      shell.tabIndex = -1;

      const panel = document.createElement("div");
      panel.className = "diagram-lightbox-panel";

      const toolbar = document.createElement("div");
      toolbar.className = "diagram-lightbox-toolbar";

      const zoomOut = makeLightboxButton("diagram-zoom-out-icon", "Zoom out");
      const zoomIn = makeLightboxButton("diagram-zoom-in-icon", "Zoom in");
      const close = makeLightboxButton("diagram-close-icon", "Close viewer");
      close.classList.add("diagram-lightbox-close");

      toolbar.appendChild(zoomOut);
      toolbar.appendChild(zoomIn);
      toolbar.appendChild(close);

      const viewport = document.createElement("div");
      viewport.className = "diagram-lightbox-viewport";

      const canvas = document.createElement("div");
      canvas.className = "diagram-lightbox-canvas";

      const clone = new Image();
      clone.src = sourceImg.currentSrc || sourceImg.src;
      clone.alt = sourceImg.alt;
      clone.className = "diagram-lightbox-image";
      clone.draggable = false;

      shell.appendChild(panel);
      panel.appendChild(toolbar);
      panel.appendChild(viewport);
      viewport.appendChild(canvas);
      canvas.appendChild(clone);
      document.body.appendChild(shell);

      let naturalWidth = Number(sourceImg.getAttribute("width")) || sourceImg.naturalWidth || 0;
      let naturalHeight = Number(sourceImg.getAttribute("height")) || sourceImg.naturalHeight || 0;
      let zoom = 1;
      let minZoom = 1;
      const maxZoom = 5;
      let isClosing = false;
      let isDragging = false;
      let dragStartX = 0;
      let dragStartY = 0;
      let dragScrollLeft = 0;
      let dragScrollTop = 0;

      function makeLightboxButton(iconId: string, title: string) {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "diagram-button";
        const template = document.getElementById(iconId);
        if (template instanceof HTMLTemplateElement) button.append(template.content.cloneNode(true));
        button.setAttribute("aria-label", title);
        button.title = title;
        return button;
      }

      function clamp(value: number, min: number, max: number) {
        return Math.min(max, Math.max(min, value));
      }

      function updateBaseZoom() {
        const width = Math.max(1, viewport.clientWidth - 24);
        const height = Math.max(1, viewport.clientHeight - 24);
        if (!naturalWidth) naturalWidth = clone.naturalWidth || width;
        if (!naturalHeight) naturalHeight = clone.naturalHeight || height;
        minZoom = Math.min(1, width / naturalWidth, height / naturalHeight);
      }

      function updateButtons() {
        zoomOut.disabled = zoom <= minZoom;
        zoomIn.disabled = zoom >= maxZoom;
      }

      function applyZoom(nextZoom: number, keepCenter: boolean) {
        updateBaseZoom();
        const oldWidth = clone.getBoundingClientRect().width || naturalWidth;
        const oldHeight = clone.getBoundingClientRect().height || naturalHeight;
        const centerX = viewport.scrollLeft + viewport.clientWidth / 2;
        const centerY = viewport.scrollTop + viewport.clientHeight / 2;

        zoom = clamp(nextZoom, minZoom, maxZoom);
        clone.style.width = Math.round(naturalWidth * zoom) + "px";

        if (keepCenter && oldWidth > 0 && oldHeight > 0) {
          requestAnimationFrame(function() {
            const newWidth = clone.getBoundingClientRect().width || oldWidth;
            const newHeight = clone.getBoundingClientRect().height || oldHeight;
            viewport.scrollLeft = Math.max(0, centerX * (newWidth / oldWidth) - viewport.clientWidth / 2);
            viewport.scrollTop = Math.max(0, centerY * (newHeight / oldHeight) - viewport.clientHeight / 2);
            updateButtons();
          });
        } else {
          viewport.scrollLeft = 0;
          viewport.scrollTop = 0;
          updateButtons();
        }
      }

      async function closeLightbox() {
        if (isClosing) return;
        isClosing = true;
        isDragging = false;
        shell.classList.remove("is-dragging");
        document.removeEventListener("keydown", onKeydown);
        window.removeEventListener("resize", onResize);
        shell.removeEventListener("cancel", onCancel);
        shell.removeEventListener("click", onDialogClick);

        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        shell.classList.remove("is-open");
        shell.classList.add("is-closing");

        const animations: Animation[] = [];
        if (!prefersReducedMotion && typeof panel.animate === "function") {
          animations.push(panel.animate(
            [
              { opacity: 1, transform: "translateY(0) scale(1)" },
              { opacity: 0, transform: "translateY(10px) scale(0.985)" },
            ],
            {
              duration: 180,
              easing: "cubic-bezier(0.25, 1, 0.5, 1)",
              fill: "forwards",
            },
          ));
        }

        if (!prefersReducedMotion && typeof shell.animate === "function") {
          animations.push(shell.animate(
            [
              { opacity: 1 },
              { opacity: 0 },
            ],
            {
              duration: 180,
              easing: "cubic-bezier(0.25, 1, 0.5, 1)",
              fill: "forwards",
            },
          ));
        }

        if (animations.length > 0) {
          await Promise.allSettled(
            animations.map(function(animation) {
              return animation.finished;
            }),
          );
        }

        if (shell.open) shell.close();
        shell.remove();
      }

      function onKeydown(event: KeyboardEvent) {
        if (event.key === "Escape") closeLightbox();
      }

      function onCancel(event: Event) {
        event.preventDefault();
        closeLightbox();
      }

      function onDialogClick(event: MouseEvent) {
        if (event.target === shell) closeLightbox();
      }

      function onPointerDown(event: PointerEvent) {
        if (event.button !== 0) return;
        isDragging = true;
        dragStartX = event.clientX;
        dragStartY = event.clientY;
        dragScrollLeft = viewport.scrollLeft;
        dragScrollTop = viewport.scrollTop;
        shell.classList.add("is-dragging");
        viewport.setPointerCapture(event.pointerId);
      }

      function onPointerMove(event: PointerEvent) {
        if (!isDragging) return;
        viewport.scrollLeft = dragScrollLeft - (event.clientX - dragStartX);
        viewport.scrollTop = dragScrollTop - (event.clientY - dragStartY);
      }

      function onPointerUp(event: PointerEvent) {
        if (!isDragging) return;
        isDragging = false;
        shell.classList.remove("is-dragging");
        if (viewport.hasPointerCapture(event.pointerId)) {
          viewport.releasePointerCapture(event.pointerId);
        }
      }

      zoomOut.addEventListener("click", function() {
        applyZoom(zoom - 0.25, true);
      });
      zoomIn.addEventListener("click", function() {
        applyZoom(zoom + 0.25, true);
      });
      close.addEventListener("click", closeLightbox);
      viewport.addEventListener("scroll", updateButtons, { passive: true });
      viewport.addEventListener("pointerdown", onPointerDown);
      viewport.addEventListener("pointermove", onPointerMove);
      viewport.addEventListener("pointerup", onPointerUp);
      viewport.addEventListener("pointercancel", onPointerUp);
      function onResize() {
        applyZoom(zoom, false);
      }
      window.addEventListener("resize", onResize, { once: true });
      document.addEventListener("keydown", onKeydown);
      shell.addEventListener("cancel", onCancel);
      shell.addEventListener("click", onDialogClick);

      shell.showModal();
      requestAnimationFrame(function() {
        shell.classList.add("is-open");
      });
      applyZoom(minZoom, false);
      shell.focus();
    }
  })();
</script>
