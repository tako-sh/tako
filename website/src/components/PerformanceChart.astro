---
import type { BenchPoint, ChartConfig, ChartUnit } from "../data/performance";

interface Props {
  chart: ChartConfig;
}

const { chart } = Astro.props;
const xAxisValues = Array.from(new Set(chart.series.flatMap((series) => series.points.map((point) => point.conc)))).sort(
  (a, b) => a - b,
);

const chartBox = {
  width: 980,
  height: 380,
  left: 64,
  top: 28,
  right: 28,
  bottom: 54,
};

const plotWidth = chartBox.width - chartBox.left - chartBox.right;
const plotHeight = chartBox.height - chartBox.top - chartBox.bottom;

const xFor = (index: number, count: number): number =>
  chartBox.left + (count <= 1 ? 0 : (index / (count - 1)) * plotWidth);

const xForConc = (conc: number): number => xFor(xAxisValues.indexOf(conc), xAxisValues.length);

const yFor = (value: number, max: number): number =>
  chartBox.top + (1 - value / max) * plotHeight;

const linePoints = (points: BenchPoint[], key: keyof BenchPoint, max: number): string =>
  points
    .map((point) => `${xForConc(point.conc).toFixed(1)},${yFor(Number(point[key]), max).toFixed(1)}`)
    .join(" ");

const formatValue = (value: number, unit: ChartUnit): string => {
  if (unit === "rps") {
    return value >= 1000 ? `${Number((value / 1000).toFixed(value >= 10000 ? 0 : 1))}k` : String(value);
  }
  if (unit === "ms") {
    return value >= 1000 ? `${Number((value / 1000).toFixed(value >= 10000 ? 0 : 1))}s` : `${value}ms`;
  }
  if (unit === "mib") {
    return value >= 1024 ? `${Number((value / 1024).toFixed(1))}GiB` : `${value}MiB`;
  }
  return `${value}%`;
};
---

<figure class="chart-panel">
  <div class="chart-copy">
    <h3>{chart.title}</h3>
    <p>{chart.description}</p>
  </div>
  <div class="chart-scroll">
    <svg
      viewBox={`0 0 ${chartBox.width} ${chartBox.height}`}
      role="img"
      aria-label={`${chart.title}. ${chart.description}`}
    >
      <rect class="chart-bg" x="0" y="0" width={chartBox.width} height={chartBox.height} rx="3"></rect>
      {
        chart.ticks.map((tick) => (
          <g>
            <line
              class="chart-grid-line"
              x1={chartBox.left}
              x2={chartBox.width - chartBox.right}
              y1={yFor(tick, chart.max)}
              y2={yFor(tick, chart.max)}
            />
            <text class="chart-tick" x={chartBox.left - 12} y={yFor(tick, chart.max) + 4} text-anchor="end">
              {formatValue(tick, chart.unit)}
            </text>
          </g>
        ))
      }
      <line class="chart-axis" x1={chartBox.left} x2={chartBox.width - chartBox.right} y1={chartBox.height - chartBox.bottom} y2={chartBox.height - chartBox.bottom} />
      {
        xAxisValues.map((conc) => (
          <text class="chart-x" x={xForConc(conc)} y={chartBox.height - 22} text-anchor="middle">
            {conc >= 1000 ? `c${conc / 1000}k` : `c${conc}`}
          </text>
        ))
      }
      {
        chart.series.map((series) => (
          <g>
            <polyline
              class:list={["chart-line", series.id === "tako" && "chart-line-tako"]}
              points={linePoints(series.points, chart.key, chart.max)}
              stroke={series.color}
              stroke-dasharray={series.dash ? "6 5" : undefined}
            />
            {
              series.points.map((point) => (
                <circle
                  class:list={["chart-point", series.id === "tako" && "chart-point-tako"]}
                  cx={xForConc(point.conc)}
                  cy={yFor(Number(point[chart.key]), chart.max)}
                  r={series.id === "tako" ? 4.8 : 3.6}
                  fill={series.color}
                >
                  <title>{`${series.label} c${point.conc}: ${formatValue(Number(point[chart.key]), chart.unit)}`}</title>
                </circle>
              ))
            }
          </g>
        ))
      }
    </svg>
  </div>
  <ul class="legend" aria-label={`${chart.title} legend`}>
    {
      chart.series.map((series) => (
        <li>
          <span class:list={["legend-swatch", series.dash && "legend-swatch-dash"]} style={`--legend-color:${series.color}`}></span>
          {series.label}
        </li>
      ))
    }
  </ul>
</figure>

<style>
  .chart-panel {
    min-width: 0;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    overflow: hidden;
  }

  .chart-copy {
    padding: 20px 20px 12px;
  }

  .chart-copy h3 {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .chart-copy p {
    max-width: 72ch;
    margin-top: 8px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .chart-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    padding: 0 10px 6px;
  }

  .chart-scroll svg {
    width: 100%;
    min-width: 820px;
    height: auto;
    display: block;
  }

  .chart-bg {
    fill: var(--bg);
  }

  .chart-grid-line {
    stroke: var(--line);
    stroke-width: 1;
  }

  .chart-axis {
    stroke: var(--line-strong);
    stroke-width: 1;
  }

  .chart-tick,
  .chart-x {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .chart-line {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  /* Tako's line runs a step heavier so it reads first in every chart. */
  .chart-line-tako {
    stroke-width: 3;
  }

  .chart-point {
    stroke: var(--bg);
    stroke-width: 1.5;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    padding: 0 20px 18px;
    list-style: none;
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 13px;
  }

  .legend-swatch {
    width: 18px;
    border-top: 2px solid var(--legend-color);
  }

  .legend-swatch-dash {
    border-top-style: dashed;
  }
</style>
