---
export interface Props {
  id?: string;
  variant?: "command" | "agent";
  class?: string;
  ariaLabel?: string;
  title?: string;
  label?: string;
}

const {
  id,
  variant = "command",
  class: className = "",
  ariaLabel = "Copy",
  title = "Copy",
  label = "Copy",
} = Astro.props;

const variantClass = `copy-button--${variant}`;
---
<button id={id} class:list={["copy-button", variantClass, className]} type="button" aria-label={ariaLabel} title={title}>
  <span class="copy-button-label" data-copy-label>{label}</span>
</button>
