---
import HugeIcon from "../components/HugeIcon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import CopyButton from "../components/CopyButton.astro";
import HomeScripts from "../components/home/HomeScripts.astro";
import HomeDocStyles from "../components/home/HomeDocStyles.astro";
import HomeDevPlayer from "../components/home/HomeDevPlayer.astro";
import HomePipeline from "../components/home/HomePipeline.astro";
import HomeBlockStyles from "../components/home/HomeBlockStyles.astro";
import HomeProductSections from "../components/home/HomeProductSections.astro";
import HomeOutOfTheBox from "../components/home/HomeOutOfTheBox.astro";
import HomeBenchmark from "../components/home/HomeBenchmark.astro";
import HomeWhoFor from "../components/home/HomeWhoFor.astro";
import HomeMotion from "../components/home/HomeMotion.astro";
import HomeTakosophy from "../components/home/HomeTakosophy.astro";
import ExternalLinkIcon from "@hugeicons/core-free-icons/LinkSquare01Icon";
import HomeSpot from "../components/home/HomeSpot.astro";
import peek from "../assets/brand/peek.png";
import { siteEntityIds } from "../config/site-identity.ts";

const homeStructuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": siteEntityIds.software,
  name: "Tako",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Linux",
  url: "https://tako.sh/",
  image: "https://tako.sh/assets/og.png",
  description: "Run apps on your own servers with local development, production deploys, routing, TLS, logs, secrets, and more.",
  softwareHelp: "https://tako.sh/docs/",
  downloadUrl: "https://tako.sh/install.sh",
  codeRepository: "https://github.com/tako-sh/tako",
  license: "https://github.com/tako-sh/tako/blob/master/LICENSE",
  publisher: { "@id": siteEntityIds.organization },
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  sameAs: ["https://github.com/tako-sh/tako", "https://www.npmjs.com/package/tako.sh"],
  featureList: [
    "Local development with HTTPS and custom domains",
    "Production deploys with rolling updates",
    "Automatic TLS and request routing",
    "Logs, secrets, and server management",
    "Durable WebSocket and SSE channels",
    "Durable workflows with cron, waits, and retries",
    "Signed uploads and file storage",
    "App data backups",
    "Public image optimization",
  ],
};
---

<BaseLayout
  title="Run apps on your own servers - Tako"
  description="Deploy apps to your own servers with rolling deploys, TLS, health checks, logs, and secrets for Node.js, Bun, Go, and more."
  structuredData={homeStructuredData}
  fullBleed
>
  <div class="home">
    <section class="band hero" data-accent="coral" aria-labelledby="hero-title">
      <div class="band-inner">
        <div class="hero-top">
          <h1 class="hero-title" id="hero-title">your app belongs on your servers</h1>
          <div class="hero-side">
          <p class="hero-sub">
            The platform layer that makes them feel like a PaaS. Tako is an opinionated
            development and deployment tool for self-hosted apps. Runs Node.js, Bun and Go
            apps, or anything with a Dockerfile.
          </p>

          <div class="hero-actions">
            <a class="button" href="/docs/quickstart/">Get started</a>
            <a class="action" href="https://demo.tako.sh" target="_blank" rel="noopener noreferrer">
              Live demo<HugeIcon icon={ExternalLinkIcon} class="button-icon" aria-hidden="true" focusable="false" />
            </a>
            <a class="action" href="/docs/">Read the docs</a>
          </div>

          <div class="hero-commands">
            <p class="command-label">Install with one command</p>
            <div class="command-row">
              <code class="command-text"><span class="prompt" aria-hidden="true">$ </span><span id="typed-cmd">curl -fsSL https://tako.sh/install.sh | sh</span></code>
              <CopyButton variant="command" id="copy" ariaLabel="Copy install command" title="Copy install command" />
            </div>
            <p class="command-label">Or ask Codex, Claude, or another agent</p>
            <div class="command-row">
              <span class="command-text" id="agent-prompt-text">Move this project to tako.sh.</span>
              <CopyButton variant="agent" id="agent-copy" ariaLabel="Copy agent prompt" title="Copy agent prompt" />
            </div>
          </div>

          <p class="hero-license">
            Open source under the <a href="https://github.com/tako-sh/tako/blob/master/LICENSE" target="_blank" rel="noopener noreferrer" title="Project code is MIT. Some dependencies, such as Pingora, are Apache-2.0.">MIT license</a>.
          </p>
          </div>
        </div>

        <div class="hero-stage">
          <HomeSpot class="hero-peek" src={peek} sizes="(max-width: 640px) 104px, 240px" origin="50% 67.8%" mouth="60% 54%" animated eager />
          <HomeDevPlayer />
        </div>
      </div>
    </section>

    <section class="band band-raised" data-accent="mint" aria-labelledby="why-title">
      <div class="band-inner">
        <div class="why">
          <h2 class="why-title" id="why-title">Deploying doesn&rsquo;t have to be dramatic.</h2>
          <div class="why-answer">
            <p class="why-lead">
              Tako brings back the old upload-and-go energy, with modern safety rails.
              Smooth local development, boring production deploys. The good kind of boring.
            </p>
            <ul class="why-points">
              <li>Ship changes quickly.</li>
              <li>See results fast.</li>
              <li>Keep your flow instead of fighting platform glue.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <HomeTakosophy />

    <section class="band band-raised band-compact" data-accent="coral" aria-labelledby="steps-title">
      <div class="band-inner">
        <h2 class="section-title" id="steps-title">Three commands and you&rsquo;re live</h2>
        <HomePipeline />
      </div>
    </section>

    <HomeProductSections />

    <HomeOutOfTheBox />

    <HomeBenchmark />

    <HomeWhoFor />

    <section class="band cta" data-accent="ink" aria-labelledby="cta-title">
      <div class="band-inner">
        <h2 class="cta-title" id="cta-title">Put it on your server.</h2>
        <div class="cta-commands">
          <p class="command-label">Install with one command</p>
          <div class="command-row">
            <code class="command-text"><span class="prompt" aria-hidden="true">$ </span><span id="cta-install-cmd">curl -fsSL https://tako.sh/install.sh | sh</span></code>
            <CopyButton variant="command" id="cta-copy" ariaLabel="Copy install command" title="Copy install command" />
          </div>
          <p class="command-label">Or ask Codex, Claude, or another agent</p>
          <div class="command-row">
            <span class="command-text" id="cta-agent-prompt">Move this project to tako.sh.</span>
            <CopyButton variant="agent" id="cta-agent-copy" ariaLabel="Copy agent prompt" title="Copy agent prompt" />
          </div>
        </div>
        <div class="hero-actions">
          <a class="button button-ink" href="/docs/quickstart/">Get started</a>
          <a class="action" href="/docs/how-tako-works/">Read how Tako works</a>
        </div>
        <p class="cta-star">
          Already enjoying Tako? Show it some love with a <a href="https://github.com/tako-sh/tako" target="_blank" rel="noopener noreferrer">star on GitHub</a>.
        </p>
      </div>
    </section>
  </div>
  <HomeDocStyles />
  <HomeBlockStyles />
  <HomeScripts />
  <HomeMotion />
</BaseLayout>
