---
import HugeIcon from "../components/HugeIcon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PerformanceChart from "../components/PerformanceChart.astro";
import ExternalLinkIcon from "@hugeicons/core-free-icons/LinkSquare01Icon";
import {
  benchmark,
  featureCharts,
  featureRow,
  format,
  httpCharts,
  httpRow,
  labels,
  performanceStructuredData,
  proxyOrder,
  reportUrl,
  short,
} from "../data/performance";
const tako5 = httpRow("tako", 5000);
const tako20 = httpRow("tako", 20000);
const takoRows = benchmark.http.filter((r) => r.proxy === "tako");
const clientErrors = takoRows.reduce((sum, r) => sum + r.clientErrors, 0);
const non200 = takoRows.reduce((sum, r) => sum + r.non200, 0);
const clean = takoRows.every((r) => r.clean);
const channel = featureRow("channel-publish", 8000);
const workflow = featureRow("workflow-enqueue", 8000);
const cpus = [...new Set(benchmark.hosts.map((h) => h.cpu))];
const kernels = [...new Set(benchmark.hosts.map((h) => h.kernel))];
const date = new Date(`${benchmark.date}T12:00:00Z`).toLocaleDateString(
  "en-GB",
  { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" },
);
const rawUrl = `https://github.com/tako-sh/performance/tree/main/results/${benchmark.resultDirectory}`;
const ranked = proxyOrder
  .map((p) => httpRow(p, 5000))
  .sort((a, b) => b.metrics.rps200.mean - a.metrics.rps200.mean);
const leader = ranked[0];
if (!leader) throw new Error("Five-proxy results are required");
---

<BaseLayout
  title="Tako Performance Benchmarks for Self-Hosted Apps"
  description="Current five-proxy HTTPS benchmarks: Tako, nginx, HAProxy, Envoy, and Caddy. Throughput, latency, errors, CPU, memory, channels, and workflows."
  structuredData={performanceStructuredData}
>
  <section class="perf-hero" aria-labelledby="performance-title">
    <span class="fact-label">Complete benchmark · {date}</span>
    <h1 id="performance-title">Serious load, measured in public.</h1>
    <p class="perf-lede">
      Tako, nginx, HAProxy, Envoy, and Caddy under the same HTTPS load. Every
      chart below comes from this benchmark suite: 105 proxy runs and 30 channel
      and workflow runs, with three repetitions at every point.
    </p>
    <div class="perf-actions" aria-label="Performance report links">
      <a
        class="button"
        href={reportUrl}
        target="_blank"
        rel="noopener noreferrer"
        >full measured report <HugeIcon
          icon={ExternalLinkIcon}
          class="button-icon"
          aria-hidden="true"
          focusable="false"
        /></a
      >
      <a class="action" href="#method">methodology</a>
      <a class="action" href="#memory">memory results</a>
    </div>
  </section>

  <section class="verdict-band" id="summary" aria-label="Benchmark summary">
    <p>
      <strong
        >{
          clean
            ? "All Tako HTTP runs completed cleanly."
            : "Overload outcomes are part of the result."
        }</strong
      > At 5,000 concurrent clients, Tako averaged {
        short(tako5.metrics.rps200.mean)
      } complete 200 responses per second; {labels[leader.proxy]} led this row at
      {short(leader.metrics.rps200.mean)}. All five proxies’ latency, memory,
      and errors stay beside their throughput.
    </p>
    <dl class="verdict-proof">
      <div><dt>largest HTTP load</dt><dd>c20000</dd></div>
      <div><dt>Tako non-200</dt><dd>{format(non200)}</dd></div>
      <div><dt>Tako client errors</dt><dd>{format(clientErrors)}</dd></div>
    </dl>
  </section>

  <section class="hardware-band" id="hardware" aria-label="Benchmark hardware">
    <div>
      <span class="fact-label">Test host</span><strong>GitHub Actions</strong><p
      >
        Free Ubuntu 24.04 runners. Each HTTP repetition runs all five proxies on
        one host.
      </p>
    </div>
    <div>
      <span class="fact-label">CPU budget</span><strong>2 logical CPUs</strong
      ><p>
        Two assigned CPUs and a 2-CPU quota, shared by proxy, app, load
        generator, and sampler.
      </p>
    </div>
    <div>
      <span class="fact-label">Memory limit</span><strong>8 GiB RAM</strong><p>
        No swap. Measured proxy memory excludes the app and load generator.
      </p>
    </div>
    <div>
      <span class="fact-label">Runtime</span><strong>Ubuntu 26.04</strong><p>
        One identical container image across all six measurement jobs.
      </p>
    </div>
  </section>
  <p class="table-note">
    Runner CPU models: {cpus.join("; ")}. Linux kernels: {kernels.join("; ")}.
    This is a new hardware baseline; these numbers are not directly comparable
    with the archived VM runs.
  </p>

  <section class="facts" id="key-results" aria-label="Key results">
    <div>
      <span class="fact-label">Tako at c5000</span><strong
        >{short(tako5.metrics.rps200.mean)} HTTP 200 RPS</strong
      ><p>
        {format(tako5.metrics.rps200.minimum)}–{
          format(tako5.metrics.rps200.maximum)
        } across three runs.
      </p>
    </div>
    <div>
      <span class="fact-label">Tako at c20000</span><strong
        >{short(tako20.metrics.rps200.mean)} HTTP 200 RPS</strong
      ><p>
        {format(tako20.metrics.success_pct.mean, 2)}% complete 200 outcomes on
        average.
      </p>
    </div>
    <div>
      <span class="fact-label">Tako memory at c20000</span><strong
        >{format(tako20.metrics.memory.mean)} MiB PSS</strong
      ><p>Mean peak proxy memory during those same throughput runs.</p>
    </div>
    <div>
      <span class="fact-label">Features at c8000</span><strong
        >{short(channel.metrics.rps200.mean)} publish / {
          short(workflow.metrics.rps200.mean)
        } enqueue</strong
      ><p>Successful HTTP requests per second, measured separately.</p>
    </div>
  </section>

  <section class="chart-section" aria-labelledby="result-limits">
    <div class="section-head">
      <h2 id="result-limits">What these results show</h2>
      <p>
        Tako was faster than Caddy at every tested concurrency, while nginx,
        HAProxy, and Envoy delivered higher successful throughput. Tako and
        HAProxy returned all 200 responses across their HTTP runs. Memory
        remains a substantial cost: Tako used {
          format(tako20.metrics.memory.mean)
        } MiB peak PSS on average at c20000.
      </p>
      <p>
        All 135 runs are included; {benchmark.cleanCases} completed without HTTP
        or client errors. Two nginx c15000 runs had 24 and 23 resource samples, below
        the planned minimum of 25, so their memory peaks may be undersampled. One
        load-generator CPU measurement at Tako c15000 was invalid after the process
        exited; that aggregate is marked unavailable in the full report. The other
        measurements were checked independently.
      </p>
    </div>
  </section>

  <section class="chart-section" aria-labelledby="proxy-results">
    <div class="section-head">
      <div class="section-title-row">
        <h2 id="proxy-results">
          The complete HTTPS comparison<a
            class="heading-anchor"
            href="#proxy-results"
            aria-label="Link to HTTPS comparison">#</a
          >
        </h2>
      </div>
      <p>
        Same route, RSA certificate, Go upstream app, load generator, and
        configured request and connection limits documented in the report. Each
        point is the mean of three fresh runs. Proxy order rotates across
        repetitions; the report retains every individual run and its range.
      </p>
    </div>
    <div class="chart-grid">
      {httpCharts.map((config) => <PerformanceChart chart={config} />)}
    </div>
    <p class="table-scroll-hint">
      Scroll tables sideways to compare all columns.
    </p>
    <div class="table-wrap">
      <table>
        <caption
          >Successful HTTPS responses per second. Secondary labels show complete
          200 outcomes as a percentage of all attempts.</caption
        >
        <thead
          ><tr
            ><th scope="col">proxy</th>{
              [5000, 10000, 20000].map((c) => (
                <th scope="col" class="num">
                  c{c} RPS
                </th>
              ))
            }<th scope="col" class="num">c20000 p99</th><th scope="col"
              >c20000 range</th
            ></tr
          ></thead
        >
        <tbody
          >{
            proxyOrder.map((proxy) => {
              const high = httpRow(proxy, 20000);
              return (
                <tr>
                  <th scope="row">{labels[proxy]}</th>
                  {[5000, 10000, 20000].map((c) => {
                    const row = httpRow(proxy, c);
                    return (
                      <td class="num">
                        <span
                          class:list={[
                            "metric-cell",
                            !row.clean && "metric-cell-overload",
                          ]}
                        >
                          <span class="metric-value">
                            {format(row.metrics.rps200.mean)}
                          </span>
                          <span class="metric-detail">
                            {format(row.metrics.success_pct.mean, 2)}% 200
                          </span>
                        </span>
                      </td>
                    );
                  })}
                  <td class="num">{format(high.metrics.p99.mean)} ms</td>
                  <td>
                    {format(high.metrics.rps200.minimum)}–
                    {format(high.metrics.rps200.maximum)} RPS
                  </td>
                </tr>
              );
            })
          }</tbody
        >
      </table>
    </div>
  </section>

  <section class="chart-section" aria-labelledby="memory">
    <div class="section-head">
      <div class="section-title-row">
        <h2 id="memory">
          Memory under the same load<a
            class="heading-anchor"
            href="#memory"
            aria-label="Link to memory results">#</a
          >
        </h2>
      </div><p>
        Memory is process PSS, which apportions shared pages instead of counting
        them twice. These values are the mean of each run’s peak during
        measurement, including request drain. Compare memory with successful
        outcomes: a proxy that rejects or times out requests is not serving
        equivalent load.
      </p>
    </div>
    <div class="table-wrap">
      <table>
        <caption
          >Mean peak proxy PSS from the same HTTPS runs, in MiB. Lower is better
          when successful outcomes are comparable.</caption
        >
        <thead
          ><tr
            ><th scope="col">proxy</th>{
              [5000, 10000, 20000].map((c) => (
                <th scope="col" class="num">
                  c{c} MiB
                </th>
              ))
            }<th scope="col" class="num">c20000 200</th><th scope="col"
              >c20000 PSS range</th
            ></tr
          ></thead
        >
        <tbody
          >{
            proxyOrder.map((proxy) => {
              const row = httpRow(proxy, 20000);
              return (
                <tr>
                  <th scope="row">{labels[proxy]}</th>
                  {[5000, 10000, 20000].map((c) => (
                    <td class="num">
                      {format(httpRow(proxy, c).metrics.memory.mean, 1)}
                    </td>
                  ))}
                  <td class="num">
                    {format(row.metrics.success_pct.mean, 2)}%
                  </td>
                  <td>
                    {format(row.metrics.memory.minimum, 1)}–
                    {format(row.metrics.memory.maximum, 1)} MiB
                  </td>
                </tr>
              );
            })
          }</tbody
        >
      </table>
    </div>
    <div class="table-wrap">
      <table>
        <caption
          >CPU distribution at c20000, as a percentage of the shared two-CPU
          budget. Means across three runs.</caption
        >
        <thead
          ><tr
            ><th scope="col">proxy</th><th scope="col" class="num">proxy CPU</th
            ><th scope="col" class="num">app CPU</th><th scope="col" class="num"
              >loadgen CPU</th
            ><th scope="col" class="num">total CPU</th><th
              scope="col"
              class="num">app PSS</th
            ></tr
          ></thead
        >
        <tbody
          >{
            proxyOrder.map((proxy) => {
              const row = httpRow(proxy, 20000);
              return (
                <tr>
                  <th scope="row">{labels[proxy]}</th>
                  {[
                    row.metrics.proxyCpu,
                    row.metrics.appCpu,
                    row.metrics.loadgenCpu,
                    row.metrics.cpu,
                  ].map((metric) => (
                    <td class="num">{format(metric.mean, 1)}%</td>
                  ))}
                  <td class="num">
                    {format(row.metrics.appMemory.mean, 1)} MiB
                  </td>
                </tr>
              );
            })
          }</tbody
        >
      </table>
    </div>
  </section>

  <section
    class="chart-section feature-section"
    aria-labelledby="feature-results"
  >
    <div class="section-head">
      <div class="section-title-row">
        <h2 id="feature-results">
          Channels and workflows<a
            class="heading-anchor"
            href="#feature-results"
            aria-label="Link to feature results">#</a
          >
        </h2>
      </div><p>
        These are the same feature operations as the original benchmark, rerun
        with the current server and SDK. Each runs in a real deployed
        application, with the same two-CPU and 8 GiB limits. Channel publish
        writes one durable message; workflow enqueue accepts a task whose
        handler persists one ack step.
      </p>
    </div>
    <div class="chart-grid">
      {featureCharts.map((config) => <PerformanceChart chart={config} />)}
    </div>
    <div class="table-wrap">
      <table>
        <caption
          >Feature results at c8000. Rates, latency, and memory are means; error
          counts are totals across three runs. Enqueue RPS measures acceptance,
          not completed workflows.</caption
        >
        <thead
          ><tr
            ><th scope="col">operation</th><th scope="col" class="num"
              >200 RPS</th
            ><th scope="col" class="num">p99</th><th scope="col" class="num"
              >200 outcomes</th
            ><th scope="col" class="num">client errors (total)</th><th
              scope="col"
              class="num">app / worker PSS</th
            ></tr
          ></thead
        >
        <tbody
          >{
            [
              { label: "Channel publish", row: channel },
              { label: "Workflow enqueue", row: workflow },
            ].map(({ label, row }) => {
              return (
                <tr>
                  <>
                    <th scope="row">{label}</th>
                    <td class="num">{format(row.metrics.rps200.mean)}</td>
                    <td class="num">{format(row.metrics.p99.mean)} ms</td>
                    <td class="num">
                      {format(row.metrics.success_pct.mean, 2)}%
                    </td>
                    <td class="num">{format(row.clientErrors)}</td>
                    <td class="num">
                      {format(row.metrics.appMemory.mean, 1)} MiB
                    </td>
                  </>
                </tr>
              );
            })
          }</tbody
        >
      </table>
    </div>
  </section>

  <section class="method-section" aria-labelledby="method">
    <div class="section-head">
      <div class="section-title-row">
        <h2 id="method">
          Same conditions, public raw data.<a
            class="heading-anchor"
            href="#method"
            aria-label="Link to methodology">#</a
          >
        </h2>
      </div><p>
        All 135 measurements are included. Results are generated from validated
        raw JSON, and the complete dataset, configurations, build identities,
        and workflow are public.
      </p>
    </div>
    <div class="method-list">
      <div>
        <strong>Timing and transport</strong><p>
          HTTP/1.1 over TLS; 10-second warmup, 30-second measurement, 60-second
          per-request timeout, 16 loopback source addresses, and a 10-second
          cooldown. RPS includes request drain. Latency measures time to
          response headers; errors remain visible separately.
        </p>
      </div>
      <div>
        <strong>Measurement</strong><p>
          Backend apps and workflow workers use matching 65,535-file descriptor
          limits, verified during measurement. Tako’s production app default is
          4,096; this high-concurrency benchmark configures the higher app
          limit. One-second process and cgroup samples. nginx memory includes
          master and worker processes. App and workflow workers are separate
          from Tako’s proxy totals. PSS excludes kernel socket memory. Chart
          points are means of three per-run values, not pooled latency
          percentiles.
        </p>
      </div>
      <div>
        <strong>Reproducible builds</strong><p>
          Tako server and SDK: <code>{benchmark.takoRevision.slice(0, 12)}</code
          >. All jobs use identical binaries and one runtime image. The full
          report records hashes and pinned sources. Worker counts and Go
          parallelism are set to two.
        </p>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <caption>Measured software versions</caption><thead
          ><tr><th scope="col">software</th><th scope="col">version</th></tr
          ></thead
        ><tbody
          >{
            Object.entries(benchmark.versions).map(([name, version]) => (
              <tr>
                <>
                  <th scope="row">{labels[name] ?? name}</th>
                  <td>{version.split("\n").find((line) => line.trim())}</td>
                </>
              </tr>
            ))
          }</tbody
        >
      </table>
    </div>
    <p class="table-note">
      The load generator and backend share the test’s CPU budget with the proxy.
      This measures the complete setup under saturation, not an isolated proxy
      ceiling or a production capacity guarantee. Separate GitHub hosts can
      vary; the full report shows individual repetitions. Historical
      measurements remain archived in the performance repository.
    </p>
    <div class="raw-links">
      <a href={rawUrl} target="_blank" rel="noopener noreferrer"
        >all raw runs and derived data <HugeIcon
          icon={ExternalLinkIcon}
          class="button-icon"
          aria-hidden="true"
          focusable="false"
        /></a
      ><a
        href="https://github.com/tako-sh/performance/blob/main/diagnostics/full-suite/README.md"
        target="_blank"
        rel="noopener noreferrer">reproduce this suite</a
      >
    </div>
  </section>
</BaseLayout>

<script>
  const headingRows = Array.from(
    document.querySelectorAll(".section-title-row"),
  );
  for (const row of headingRows) {
    const heading = row.querySelector("h2[id]");
    const anchor = row.querySelector(".heading-anchor");
    const hash = anchor?.getAttribute("href")?.replace(/^#/, "");
    if (!(heading instanceof HTMLElement) || !hash) {
      continue;
    }

    heading.classList.add("clickable-heading");
    heading.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) {
        return;
      }
      if (event.target.closest("a")) {
        return;
      }
      if (window.getSelection()?.toString()) {
        return;
      }
      window.location.hash = hash;
    });
  }
</script>

<style>
  /*
   * The benchmark as one long document: left-aligned headings, hairline-ruled bands and
   * tables, and the site's single radius. Colour lives in the charts' data lines.
   */
  .perf-hero {
    padding: clamp(40px, 6vw, 80px) 0 32px;
  }

  .perf-hero h1 {
    max-width: 20ch;
    font-size: clamp(40px, 5.4vw, 64px);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .perf-lede {
    max-width: 62ch;
    margin-top: 20px;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .perf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .raw-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 24px;
  }

  .raw-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }

  /* TLDR: the claim on the left, its three numbers in ruled cells on the right */
  .verdict-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    margin: 8px 0 40px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .verdict-band p {
    max-width: 68ch;
    padding: 20px 24px;
    color: var(--ink);
    font-size: 16px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .verdict-proof {
    display: grid;
    grid-template-columns: repeat(3, auto);
    margin: 0;
  }

  .verdict-proof div {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: 16px 24px;
    border-left: 1px solid var(--line);
  }

  .verdict-proof dt,
  .fact-label {
    color: var(--muted);
    font-size: 13px;
  }

  .verdict-proof dd {
    margin-top: 4px;
    color: var(--ink);
    font-size: 22px;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .hardware-band,
  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 110px;
  }

  .hardware-band {
    border-top: 1px solid var(--line);
  }

  .hardware-band div,
  .facts div {
    min-width: 0;
    padding: 20px 20px 22px;
  }

  .hardware-band div:first-child,
  .facts div:first-child {
    padding-left: 0;
  }

  /* Same weight as the :nth-child overrides in the media queries, so those win. */
  .hardware-band div:not(:first-child),
  .facts div:not(:first-child) {
    border-left: 1px solid var(--line);
  }

  .hardware-band strong,
  .facts strong {
    display: block;
    margin-top: 6px;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }

  .hardware-band p,
  .facts p {
    margin-top: 6px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .chart-section,
  .explain-grid,
  .method-section {
    margin-top: clamp(56px, 7vw, 96px);
    scroll-margin-top: 110px;
  }

  .section-head {
    max-width: 760px;
  }

  .section-head h2,
  .explain-grid h2 {
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .section-title-row h2[id] {
    scroll-margin-top: 110px;
  }

  .section-title-row .clickable-heading {
    cursor: pointer;
  }

  .section-title-row .clickable-heading:hover {
    background: linear-gradient(
        color-mix(in srgb, var(--primary) 45%, transparent),
        color-mix(in srgb, var(--primary) 45%, transparent)
      )
      left bottom / 100% 0.3em no-repeat;
  }

  .heading-anchor {
    display: inline-block;
    margin-left: 8px;
    font-size: 0.75em;
    line-height: 1;
    color: var(--primary);
    text-decoration: none;
    opacity: 0;
    cursor: pointer;
    transition: opacity 0.14s ease;
  }

  .section-title-row .clickable-heading:hover .heading-anchor,
  .heading-anchor:focus-visible {
    opacity: 1;
  }

  .heading-anchor:focus-visible {
    outline-offset: 3px;
  }

  .section-head p,
  .explain-copy p {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .section-head p {
    margin-top: 14px;
  }

  .explain-copy p + p {
    margin-top: 14px;
  }

  .chart-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    margin-top: 28px;
  }

  .table-wrap {
    margin-top: 24px;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .table-scroll-hint {
    display: none;
    color: var(--muted);
    font-size: 14px;
  }

  .table-note {
    max-width: 90ch;
    padding: 16px 18px 0;
    color: var(--ink);
    font-size: 14px;
    line-height: 1.6;
  }

  table {
    width: 100%;
    min-width: 820px;
    border-collapse: collapse;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  caption {
    padding: 14px 18px;
    text-align: left;
