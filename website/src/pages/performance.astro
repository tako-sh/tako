---
import HugeIcon from "../components/HugeIcon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PerformanceChart from "../components/PerformanceChart.astro";
import ExternalLinkIcon from "@hugeicons/core-free-icons/LinkSquare01Icon";
import {
  featureCharts,
  heavyRows,
  httpCharts,
  memoryRows,
  performanceStructuredData,
} from "../data/performance";
import type { SummaryMetric } from "../data/performance";
import bufferPerformance from "../data/buffer-performance.json";

const metricClasses = (metric: SummaryMetric) => ["metric-cell", !metric.clean && "metric-cell-overload"];
const formatNumber = (value: number) => value.toLocaleString("en-US", { maximumFractionDigits: 1 });
const [heldMemory, streamingMemory] = bufferPerformance.memory;
if (!heldMemory || !streamingMemory) throw new Error("Both memory benchmark workloads are required.");
---

<BaseLayout
  title="Tako Performance Benchmarks for Self-Hosted Apps"
  description="Tako benchmark results with raw proxy throughput, p99 latency, CPU, memory, channels, workflows, and methodology."
  structuredData={performanceStructuredData}
>
  <section class="perf-hero" aria-labelledby="performance-title">
    <div class="perf-hero-copy">
      <h1 id="performance-title">Serious load, measured in public.</h1>
      <p class="perf-lede">
        Memory, throughput, tail latency, and CPU measured with raw results published for inspection. The latest buffer tests and earlier five-proxy VM measurements are shown with their own workloads and hardware.
      </p>
      <div class="perf-actions" aria-label="Performance report links">
        <a class="button" href="https://github.com/tako-sh/performance/blob/main/RESULTS.md" target="_blank" rel="noopener noreferrer">
          raw report
          <HugeIcon icon={ExternalLinkIcon} class="button-icon" aria-hidden="true" focusable="false" />
        </a>
        <a class="action" href="#method">methodology</a>
        <a class="action" href="#buffer-memory">latest memory results</a>
      </div>
    </div>
  </section>

  <section class="chart-section" id="buffer-memory" aria-labelledby="buffer-memory-title">
    <div class="section-head">
      <span class="fact-label">{bufferPerformance.date} · {bufferPerformance.stage}</span>
      <div class="section-title-row">
        <h2 id="buffer-memory-title">Less memory while connections stay open<a class="heading-anchor" href="#buffer-memory" aria-label="Link to section: Less memory while connections stay open" title="Link to this section">#</a></h2>
      </div>
      <p>
        Empty socket buffers are released during idle reads, and completed upload buffers are released before a streaming response finishes. Transfers retain 64 KiB reads.
      </p>
      <p>
        Tako uses {formatNumber(heldMemory.savingPercent)}% less memory with 20,000 held TLS connections and {formatNumber(streamingMemory.savingPercent)}% less during uploads followed by streaming responses, compared with the unchanged build.
      </p>
    </div>

    <p class="table-scroll-hint">Scroll tables sideways to compare all columns.</p>
    <div class="table-wrap">
      <table>
        <caption>Retained proxy memory, MiB PSS. Lower is better.</caption>
        <thead>
          <tr>
            <th scope="col">workload</th>
            <th scope="col" class="num">Tako before</th>
            <th scope="col" class="num">{bufferPerformance.candidateLabel}</th>
            <th scope="col" class="num">Caddy</th>
            <th scope="col" class="num">Tako saving</th>
          </tr>
        </thead>
        <tbody>
          {bufferPerformance.memory.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td class="num">{formatNumber(row.baseline)}</td>
              <td class="num"><strong>{formatNumber(row.candidate)}</strong></td>
              <td class="num">{formatNumber(row.caddy)}</td>
              <td class="num">{formatNumber(row.savingPercent)}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="table-note" id="buffer-method">
      Mean of three runs&rsquo; median holding-phase PSS. Each held connection completes 21 checked requests; each streaming request uploads 128 KiB before its response stays open for ten seconds. These measure live retained memory, not maximum throughput. Client, app, and kernel socket memory are excluded.
    </p>

    <div class="section-head">
      <h3>Throughput alongside memory</h3>
      <p>{bufferPerformance.performanceNote}</p>
    </div>
    <div class="table-wrap">
      <table>
        <caption>Longer checks: eight paired 60-second measurements per workload. Successful requests per second.</caption>
        <thead>
          <tr>
            <th scope="col">workload</th>
            <th scope="col" class="num">Tako before</th>
            <th scope="col" class="num">{bufferPerformance.candidateLabel}</th>
            <th scope="col" class="num">change</th>
          </tr>
        </thead>
        <tbody>
          {bufferPerformance.longerTraffic.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td class="num">{formatNumber(row.baseline)}</td>
              <td class="num">{formatNumber(row.candidate)}</td>
              <td class="num">{row.changePercent > 0 ? "+" : ""}{row.changePercent.toFixed(2)}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="table-wrap">
      <table>
        <caption>Three-proxy comparison: means of three 15-second measurements. Successful requests per second; higher is better.</caption>
        <thead>
          <tr>
            <th scope="col">workload</th>
            <th scope="col" class="num">Tako before</th>
            <th scope="col" class="num">{bufferPerformance.candidateLabel}</th>
            <th scope="col" class="num">Caddy</th>
          </tr>
        </thead>
        <tbody>
          {bufferPerformance.traffic.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td class="num">{formatNumber(row.baseline)}</td>
              <td class="num">{formatNumber(row.candidate)}</td>
              <td class="num">{formatNumber(row.caddy)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="table-note">
      Free GitHub runners, with the proxy, load generator, and real deployed app sharing a 2 CPU quota, 8 GiB RAM, and no swap. Each row compares variants on the same runner; HTTP/1 and HTTP/2 groups use separate runners. Small-response results do not imply an advantage for every bulk-transfer workload. Full latency, CPU, correctness, repetitions, and build identities are in the report.
    </p>
    <div class="raw-links">
      <a href={bufferPerformance.reportUrl} target="_blank" rel="noopener noreferrer">Read the measured report and raw data <HugeIcon icon={ExternalLinkIcon} class="button-icon" aria-hidden="true" focusable="false" /></a>
    </div>
  </section>

  <div class="section-head">
    <h2>Earlier five-proxy VM measurements</h2>
    <p>The following charts retain the previously published VM results. Their active-load workloads and builds differ from the buffer-lifetime tests above.</p>
  </div>

  <section class="verdict-band" id="summary" aria-label="Benchmark summary">
    <p><strong>VM result:</strong> Tako stayed clean through c20000 on a small <a href="https://exe.dev" target="_blank" rel="noopener noreferrer nofollow">exe.dev</a> VM while doing app-aware routing, limiter accounting, forwarding headers, and instance selection.</p>
    <dl class="verdict-proof" aria-label="TLDR evidence">
      <div>
        <dt>largest run</dt>
        <dd>c20000</dd>
      </div>
      <div>
        <dt>non-200</dt>
        <dd>0</dd>
      </div>
      <div>
        <dt>client errors</dt>
        <dd>0</dd>
      </div>
    </dl>
  </section>

  <section class="hardware-band" id="hardware" aria-label="Benchmark hardware">
    <div>
      <span class="fact-label">Benchmark VM</span>
      <strong>exe.dev, Tokyo</strong>
      <p>Load generator, proxy, and app all share this host.</p>
    </div>
    <div>
      <span class="fact-label">CPU</span>
      <strong>2 vCPU</strong>
      <p>AMD EPYC 9554P on KVM.</p>
    </div>
    <div>
      <span class="fact-label">Memory</span>
      <strong>7.8 GiB RAM</strong>
      <p>No swap configured.</p>
    </div>
    <div>
      <span class="fact-label">OS</span>
      <strong>Ubuntu 24.04.4</strong>
      <p>Linux 6.12.90.</p>
    </div>
  </section>

  <section class="facts" id="key-results" aria-label="Key results">
    <div>
      <span class="fact-label">Tako at c5000</span>
      <strong>12.5k clean 200 RPS</strong>
      <p>0 non-200, 0 client errors.</p>
    </div>
    <div>
      <span class="fact-label">Tako at c20000</span>
      <strong>7.3k clean 200 RPS</strong>
      <p>Stable at the largest tested HTTP concurrency.</p>
    </div>
    <div>
      <span class="fact-label">Clean through c20000</span>
      <strong>all 200 responses</strong>
      <p>0 client errors in every heavy Tako row.</p>
    </div>
    <div>
      <span class="fact-label">Features</span>
      <strong>clean through c8000</strong>
      <p>Channels and workflows both stay clean through c8000.</p>
    </div>
  </section>

  <section class="chart-section" aria-labelledby="proxy-results">
    <div class="section-head">
      <div class="section-title-row">
        <h2 id="proxy-results">Raw HTTPS proxy path<a class="heading-anchor" href="#proxy-results" aria-label="Link to section: Raw HTTPS proxy path" title="Link to this section">#</a></h2>
      </div>
      <p>
        Same route, same self-signed TLS certificate, same upstream application, same benchmark VM. The heavy rows show saturation behavior on one small VM; Memory uses a focused five-proxy rerun with process PSS sampling.
      </p>
    </div>

    <div class="chart-grid">
      {httpCharts.map((chartConfig) => <PerformanceChart chart={chartConfig} />)}
    </div>

    <div class="table-wrap">
      <table>
        <caption>Heavy rows; secondary labels show the percentage of requests that returned 200</caption>
        <thead>
          <tr>
            <th scope="col">proxy</th>
            <th scope="col" class="num">c5000</th>
            <th scope="col" class="num">c10000</th>
            <th scope="col" class="num">c20000</th>
            <th scope="col" class="num">c20000 p99</th>
            <th scope="col">notes</th>
          </tr>
        </thead>
        <tbody>
          {heavyRows.map((row) => (
            <tr>
              <th scope="row">{row.proxy}</th>
              <td class="num">
                <span class:list={metricClasses(row.c5000)}>
                  <span class="metric-value">{row.c5000.value}</span>
                  {row.c5000.detail && <span class="metric-detail">{row.c5000.detail}</span>}
                </span>
              </td>
              <td class="num">
                <span class:list={metricClasses(row.c10000)}>
                  <span class="metric-value">{row.c10000.value}</span>
                  {row.c10000.detail && <span class="metric-detail">{row.c10000.detail}</span>}
                </span>
              </td>
              <td class="num">
                <span class:list={metricClasses(row.c20000)}>
                  <span class="metric-value">{row.c20000.value}</span>
                  {row.c20000.detail && <span class="metric-detail">{row.c20000.detail}</span>}
                </span>
              </td>
              <td class="num">
                <span class:list={metricClasses(row.p99)}>
                  <span class="metric-value">{row.p99.value}</span>
                  {row.p99.detail && <span class="metric-detail">{row.p99.detail}</span>}
                </span>
              </td>
              <td>{row.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="table-wrap">
      <p class="table-note">
        <strong>Caddy c20000 is not equal capacity.</strong> Its Memory is lower than Tako's, but Caddy only returned 94.14% 200 while Tako returned 100% 200.
      </p>
      <table>
        <caption>Memory detail from the focused PSS rerun</caption>
        <thead>
          <tr>
            <th scope="col">proxy</th>
            <th scope="col" class="num">c5000 Memory</th>
            <th scope="col" class="num">c10000 Memory</th>
            <th scope="col" class="num">c20000 Memory</th>
            <th scope="col" class="num">c20000 200</th>
          </tr>
        </thead>
        <tbody>
          {memoryRows.map((row) => (
            <tr>
              <th scope="row">{row.proxy}</th>
              <td class="num">{row.c5000}</td>
              <td class="num">{row.c10000}</td>
              <td class="num">{row.c20000}</td>
              <td class="num">{row.c20000Detail}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="chart-section feature-section" aria-labelledby="feature-results">
    <div class="section-head">
      <div class="section-title-row">
        <h2 id="feature-results">Built-in feature paths, measured separately<a class="heading-anchor" href="#feature-results" aria-label="Link to section: Built-in feature paths" title="Link to this section">#</a></h2>
      </div>
      <p>
        These rows exercise more than the proxy. The app uses the JavaScript SDK, publishes durable channel messages, and enqueues workflows with persisted steps while everything shares the same 2 vCPU budget.
      </p>
    </div>

    <div class="chart-grid">
      {featureCharts.map((chartConfig) => <PerformanceChart chart={chartConfig} />)}
    </div>
  </section>

  <section class="explain-grid" aria-labelledby="what-it-means">
    <div>
      <div class="section-title-row">
        <h2 id="what-it-means">App-aware routing under load.<a class="heading-anchor" href="#what-it-means" aria-label="Link to section: App-aware routing under load" title="Link to this section">#</a></h2>
      </div>
    </div>
    <div class="explain-copy">
      <p>
        Tako stayed clean while doing product work a static reverse proxy does not need to do: route lookup, source IP derivation, per-client limiter accounting, app and instance selection, in-flight accounting, upstream peer construction, and forwarding header normalization.
      </p>
      <p>
        The report still keeps static proxy references, p99, Memory, and clean-run percentages in view because those are the tuning levers. Future runs can isolate larger-VM behavior, external same-region load generation, and narrower Pingora session and upstream-proxy costs under 10k to 20k live TLS connections.
      </p>
    </div>
  </section>

  <section class="method-section" aria-labelledby="method">
    <div class="section-head">
      <div class="section-title-row">
        <h2 id="method">Same conditions, public raw data.<a class="heading-anchor" href="#method" aria-label="Link to section: benchmark method" title="Link to this section">#</a></h2>
      </div>
      <p>
        The public report intentionally omits hostnames, public IPs, private network addresses, peer names, and user identifiers.
      </p>
    </div>

    <div class="method-list">
      <div>
        <strong>HTTP path</strong>
        <p>Load generator, proxy, and app all run on the VM. The route is <code>bench.test:18443</code>, resolved to loopback, with Host and SNI set to <code>bench.test</code>.</p>
      </div>
      <div>
        <strong>Proxy matrix</strong>
        <p>Tako HTTP matrix <code>tako-server 0.0.0-09b3dc6</code>, feature rerun <code>tako-server 0.0.0-958986f</code>, nginx 1.24.0, HAProxy 2.8.16, Envoy 1.38.0, Caddy 2.11.3 with rate limiting.</p>
      </div>
      <div>
        <strong>Timing</strong>
        <p>10 second warmup, 30 second measurement window, HTTP/1.1 over TLS, 60 second request timeout, metrics sampled from <code>/proc</code> once per second.</p>
      </div>
    </div>

    <div class="raw-links">
      <a href="https://github.com/tako-sh/performance/tree/main/results/20260602T052009Z/http-vm-local" target="_blank" rel="noopener noreferrer">
        HTTP raw rows
        <HugeIcon icon={ExternalLinkIcon} class="button-icon" aria-hidden="true" focusable="false" />
      </a>
      <a href="https://github.com/tako-sh/performance/tree/main/results/20260604T055839Z/tako-features-vm-local" target="_blank" rel="noopener noreferrer">
        feature raw rows
        <HugeIcon icon={ExternalLinkIcon} class="button-icon" aria-hidden="true" focusable="false" />
      </a>
      <a href="https://github.com/tako-sh/performance" target="_blank" rel="noopener noreferrer">
        benchmark harness
        <HugeIcon icon={ExternalLinkIcon} class="button-icon" aria-hidden="true" focusable="false" />
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const headingRows = Array.from(document.querySelectorAll(".section-title-row"));
  for (const row of headingRows) {
    const heading = row.querySelector("h2[id]");
    const anchor = row.querySelector(".heading-anchor");
    const hash = anchor?.getAttribute("href")?.replace(/^#/, "");
    if (!(heading instanceof HTMLElement) || !hash) {
      continue;
    }

    heading.classList.add("clickable-heading");
    heading.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) {
        return;
      }
      if (event.target.closest("a")) {
        return;
      }
      if (window.getSelection()?.toString()) {
        return;
      }
      window.location.hash = hash;
    });
  }
</script>

<style>
  /*
   * The benchmark as one long document: left-aligned headings, hairline-ruled bands and
   * tables, and the site's single radius. Colour lives in the charts' data lines.
   */
  .perf-hero {
    padding: clamp(40px, 6vw, 80px) 0 32px;
  }

  .perf-hero h1 {
    max-width: 20ch;
    font-size: clamp(40px, 5.4vw, 64px);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .perf-lede {
    max-width: 62ch;
    margin-top: 20px;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .perf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .raw-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 24px;
  }

  .raw-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }

  /* TLDR: the claim on the left, its three numbers in ruled cells on the right */
  .verdict-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    margin: 8px 0 40px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .verdict-band p {
    max-width: 68ch;
    padding: 20px 24px;
    color: var(--ink);
    font-size: 16px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .verdict-proof {
    display: grid;
    grid-template-columns: repeat(3, auto);
    margin: 0;
  }

  .verdict-proof div {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: 16px 24px;
    border-left: 1px solid var(--line);
  }

  .verdict-proof dt,
  .fact-label {
    color: var(--muted);
    font-size: 13px;
  }

  .verdict-proof dd {
    margin-top: 4px;
    color: var(--ink);
    font-size: 22px;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .hardware-band,
  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 110px;
  }

  .hardware-band {
    border-top: 1px solid var(--line);
  }

  .hardware-band div,
  .facts div {
    min-width: 0;
    padding: 20px 20px 22px;
  }

  .hardware-band div:first-child,
  .facts div:first-child {
    padding-left: 0;
  }

  /* Same weight as the :nth-child overrides in the media queries, so those win. */
  .hardware-band div:not(:first-child),
  .facts div:not(:first-child) {
    border-left: 1px solid var(--line);
  }

  .hardware-band strong,
  .facts strong {
    display: block;
    margin-top: 6px;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }

  .hardware-band p,
  .facts p {
    margin-top: 6px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .chart-section,
  .explain-grid,
  .method-section {
    margin-top: clamp(56px, 7vw, 96px);
    scroll-margin-top: 110px;
  }

  .section-head {
    max-width: 760px;
  }

  .section-head h2,
  .explain-grid h2 {
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .section-title-row h2[id] {
    scroll-margin-top: 110px;
  }

  .section-title-row .clickable-heading {
    cursor: pointer;
  }

  .section-title-row .clickable-heading:hover {
    background: linear-gradient(color-mix(in srgb, var(--primary) 45%, transparent), color-mix(in srgb, var(--primary) 45%, transparent)) left bottom / 100% 0.3em no-repeat;
  }

  .heading-anchor {
    display: inline-block;
    margin-left: 8px;
    font-size: 0.75em;
    line-height: 1;
    color: var(--primary);
    text-decoration: none;
    opacity: 0;
    cursor: pointer;
    transition: opacity 0.14s ease;
  }

  .section-title-row .clickable-heading:hover .heading-anchor,
  .heading-anchor:focus-visible {
    opacity: 1;
  }

  .heading-anchor:focus-visible {
    outline-offset: 3px;
  }

  .section-head p,
  .explain-copy p {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .section-head p {
    margin-top: 14px;
  }

  .explain-copy p + p {
    margin-top: 14px;
  }

  .chart-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    margin-top: 28px;
  }

  .table-wrap {
    margin-top: 24px;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .table-scroll-hint {
    display: none;
    color: var(--muted);
    font-size: 14px;
  }

  .table-note {
    max-width: 90ch;
    padding: 16px 18px 0;
    color: var(--ink);
    font-size: 14px;
    line-height: 1.6;
  }

  table {
    width: 100%;
    min-width: 820px;
    border-collapse: collapse;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  caption {
    padding: 14px 18px;
    text-align: left;
    color: var(--muted);
    font-size: 13px;
  }

  th,
  td {
    padding: 11px 18px;
    border-top: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
    white-space: nowrap;
  }

  thead th {
    background: var(--paper);
    color: var(--ink);
    font-weight: 600;
  }

  tbody th {
    color: var(--ink);
    font-weight: 600;
  }

  tbody tr:nth-child(even) {
    background: var(--zebra);
  }

  td {
    color: var(--muted);
  }

  th.num,
  td.num {
    text-align: right;
  }

  .metric-cell {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .metric-value {
    color: var(--muted);
  }

  .metric-cell-overload .metric-value {
    color: var(--ink);
  }

  .metric-detail {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.3;
  }

  .explain-grid {
    display: grid;
    grid-template-columns: minmax(240px, 0.7fr) minmax(0, 1.3fr);
    gap: 32px;
    align-items: start;
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
