---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Page not found - Tako"
  description="This tentacle leads nowhere. Head back home or check the docs."
  noCanonical={true}
>
  <meta slot="head" name="robots" content="noindex, follow" />

  <section class="notfound">
    <p class="code">404</p>
    <h1 class="title">This tentacle leads nowhere</h1>
    <p class="subtitle">
      We couldn't find the page you're looking for. It may have been redeployed out of existence.
    </p>

    <div class="actions">
      <a class="button" href="/">back home</a>
      <a class="action" href="/docs/">or read the docs</a>
    </div>
  </section>

</BaseLayout>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 40px 16px 48px;
    gap: 16px;
  }

  .code {
    font-family: var(--font-mono);
    font-size: clamp(64px, 14vw, 148px);
    font-weight: 700;
    line-height: 1;
    color: var(--primary-text);
  }

  .title {
    font-family: var(--font-heading);
    font-size: clamp(26px, 4.5vw, 40px);
    font-weight: 700;
    line-height: 1.2;
    color: var(--ink);
    max-width: 22ch;
    text-wrap: balance;
  }


  .subtitle {
    font-size: 17px;
    color: var(--muted);
    max-width: 50ch;
    line-height: 1.55;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 8px;
  }

  @media (max-width: 520px) {
    .notfound {
      padding-top: 28px;
      gap: 14px;
    }
    .subtitle {
      font-size: 16px;
    }
  }

</style>
